// envor.font: TrueType fonts (PLAN §5, M8.4). Parses the tables a renderer needs (head,
// hhea, maxp, cmap formats 4 and 12, hmtx, loca, glyf with simple and composite
// glyphs) and rasterizes outlines with anti-aliasing: quadratic curves are flattened in
// fixed point (1/256 pixel), and coverage is measured exactly across each pixel on four
// sub-rows (non-zero winding). A font file is untrusted input: every read is checked,
// and a malformed font gives an error or empty glyphs, never a read outside the file.
namespace envor.font;

use envor.gfx;
use std.fs;
use alloc.map.{Map};

// What drawing has looked up and rendered before, kept for the font's life: glyph indexes
// by code point, and coverage by glyph, size and sub-pixel offset (so a cached glyph is
// exactly the one Render would make). The Font holds it on the heap, so drawing through a
// Font passed as `in` still fills it.
struct GlyphCache {
    Map<u64, u64> Index;    // code point -> 1 + glyph index
    Map<u64, u64> Slots;    // glyph | size << 24 | shift << 48 -> 1 + index in Masks
    List<Mask> Masks;
}

// A glyph's coverage: W x H alpha values (0-255), rows from the top. Left and Top place
// its top-left corner relative to the pen on the baseline (Top is negative above it).
public struct Mask {
    i32 W;
    i32 H;
    i32 L;
    i32 T;
    List<u8> A;

    public i32 Width(in this) => this.W;
    public i32 Height(in this) => this.H;
    public i32 Left(in this) => this.L;
    public i32 Top(in this) => this.T;
    public u8[] Alpha(in this) => this.A.AsSlice();

    public u8 At(in this, i32 x, i32 y) {
        if (x < 0 || y < 0 || x >= this.W || y >= this.H) return 0;
        return this.A.Get((y * this.W + x) as usize);
    }

    // The mask as text, for tests: ' ' . : o # by coverage.
    public string Art(in this) {
        string s = string.New();
        for (i32 y = 0; y < this.H; y++) {
            for (i32 x = 0; x < this.W; x++) {
                u8 a = this.At(x, y);
                if (a == 0) s.AppendByte(' ');
                else if (a < 64) s.AppendByte('.');
                else if (a < 128) s.AppendByte(':');
                else if (a < 224) s.AppendByte('o');
                else s.AppendByte('#');
            }
            s.AppendByte(10);
        }
        return s;
    }
}

// An outline point in font units.
struct Pt {
    i32 X;
    i32 Y;
    bool On;
}

// A line of the flattened outline, in 1/256 pixel, y down.
struct Seg {
    i64 X0;
    i64 Y0;
    i64 X1;
    i64 Y1;
}

const u32 MAX_DEPTH = 8;            // composite glyphs nest at most this deep
const usize MAX_POINTS = 65536;     // points in one glyph, composites included

public struct Font {
    List<u8> D;
    usize Glyf;
    usize GlyfLen;
    usize Loca;
    bool LongLoca;
    usize Hmtx;
    u32 Metrics;            // hhea's numberOfHMetrics
    u32 Glyphs;             // maxp's numGlyphs
    usize Cmap;             // the chosen cmap subtable
    u32 CmapFormat;
    i32 Upem;
    i32 Asc;
    i32 Desc;
    i32 Gap;
    usize Cache;            // *GlyphCache

    // Parses a TrueType font (a .ttf file's bytes).
    public static Result<Font, string> Parse(u8[] data) {
        return Font.Build(CopyBytes(data));
    }

    // Parses a font read as text (std.fs.ReadText gives a file's bytes as a string).
    public static Result<Font, string> ParseText(str data) {
        unsafe { return Font.Build(CopyBytes(slice_from(data.Ptr, data.Len))); }
    }

    static Result<Font, string> Build(List<u8> d) {
        Font f = new Font { D = d, Glyf = 0, GlyfLen = 0, Loca = 0, LongLoca = false, Hmtx = 0, Metrics = 0, Glyphs = 0, Cmap = 0, CmapFormat = 0, Upem = 0, Asc = 0, Desc = 0, Gap = 0, Cache = 0 };
        unsafe {
            *GlyphCache gc = alloc(sizeof(GlyphCache)) as *GlyphCache;
            gc[0] = new GlyphCache { Index = Map<u64, u64>.New(), Slots = Map<u64, u64>.New(), Masks = List<Mask>.New() };
            f.Cache = gc as usize;
        }
        u32 version = f.U32(0);
        if (version != 0x00010000 && version != 0x74727565) return Err(string.From("not a TrueType font"));
        usize head = f.Table("head");
        usize hhea = f.Table("hhea");
        usize maxp = f.Table("maxp");
        usize cmap = f.Table("cmap");
        f.Hmtx = f.Table("hmtx");
        f.Loca = f.Table("loca");
        f.Glyf = f.Table("glyf");
        f.GlyfLen = f.TableLen("glyf");
        if (head == 0 || hhea == 0 || maxp == 0 || cmap == 0 || f.Hmtx == 0 || f.Loca == 0 || f.Glyf == 0) return Err(string.From("a table the font needs is missing"));
        f.Upem = f.U16(head + 18) as i32;
        if (f.Upem < 16 || f.Upem > 16384) return Err(string.From("unitsPerEm out of range"));
        f.LongLoca = f.U16(head + 50) == 1;
        f.Asc = f.I16(hhea + 4);
        f.Desc = f.I16(hhea + 6);
        f.Gap = f.I16(hhea + 8);
        f.Metrics = f.U16(hhea + 34);
        f.Glyphs = f.U16(maxp + 4);
        if (f.Metrics == 0 || f.Glyphs == 0) return Err(string.From("no glyphs"));
        // a Unicode subtable: format 12 (all planes) before format 4 (the first plane)
        u32 n = f.U16(cmap + 2);
        for (u32 i = 0; i < n; i++) {
            usize rec = cmap + 4 + 8 * i as usize;
            u32 platform = f.U16(rec);
            u32 encoding = f.U16(rec + 2);
            usize sub = cmap + f.U32(rec + 4) as usize;
            u32 format = f.U16(sub);
            bool unicode = platform == 0 || platform == 3 && (encoding == 1 || encoding == 10);
            if (!unicode) continue;
            if (format == 12 || format == 4 && f.CmapFormat != 12) {
                f.Cmap = sub;
                f.CmapFormat = format;
            }
        }
        if (f.CmapFormat == 0) return Err(string.From("no Unicode character map"));
        return Ok(f);
    }

    // ---------------------------------------------------------------- checked reads

    u32 U8(in this, usize at) {
        if (at >= this.D.Len()) return 0;
        return this.D.Get(at) as u32;
    }

    u32 U16(in this, usize at) => this.U8(at) << 8 | this.U8(at + 1);
    i32 I16(in this, usize at) => this.U16(at) as u16 as i16 as i32;
    u32 U32(in this, usize at) => this.U16(at) << 16 | this.U16(at + 2);

    // The offset of the table tagged tag; 0 if there is none (or it lies outside the file).
    usize Table(in this, str tag) {
        u32 n = this.U16(4);
        for (u32 i = 0; i < n; i++) {
            usize rec = 12 + 16 * i as usize;
            if (this.U8(rec) == tag[0] as u32 && this.U8(rec + 1) == tag[1] as u32 && this.U8(rec + 2) == tag[2] as u32 && this.U8(rec + 3) == tag[3] as u32) {
                usize off = this.U32(rec + 8) as usize;
                usize len = this.U32(rec + 12) as usize;
                if (off == 0 || off > this.D.Len() || len > this.D.Len() - off) return 0;
                return off;
            }
        }
        return 0;
    }

    usize TableLen(in this, str tag) {
        u32 n = this.U16(4);
        for (u32 i = 0; i < n; i++) {
            usize rec = 12 + 16 * i as usize;
            if (this.U8(rec) == tag[0] as u32 && this.U8(rec + 1) == tag[1] as u32 && this.U8(rec + 2) == tag[2] as u32 && this.U8(rec + 3) == tag[3] as u32) return this.U32(rec + 12) as usize;
        }
        return 0;
    }

    // ---------------------------------------------------------------- metrics

    public i32 UnitsPerEm(in this) => this.Upem;
    public i32 Ascent(in this) => this.Asc;
    public i32 Descent(in this) => this.Desc;
    public i32 LineGap(in this) => this.Gap;
    public u32 GlyphCount(in this) => this.Glyphs;

    // The glyph for code point c; 0 (.notdef) if the font has none.
    public u32 GlyphIndex(in this, u32 c) {
        usize t = this.Cmap;
        if (this.CmapFormat == 12) {
            u32 groups = this.U32(t + 12);
            for (u32 i = 0; i < groups && i < 1000000; i++) {
                usize g = t + 16 + 12 * i as usize;
                u32 start = this.U32(g);
                u32 end = this.U32(g + 4);
                if (c >= start && c <= end) return this.Valid(this.U32(g + 8) + (c - start));
            }
            return 0;
        }
        if (c > 0xFFFF) return 0;
        u32 segs = this.U16(t + 6) / 2;
        usize ends = t + 14;
        usize starts = ends + 2 * segs as usize + 2;
        usize deltas = starts + 2 * segs as usize;
        usize ranges = deltas + 2 * segs as usize;
        for (u32 i = 0; i < segs; i++) {
            u32 end = this.U16(ends + 2 * i as usize);
            if (c > end) continue;
            u32 start = this.U16(starts + 2 * i as usize);
            if (c < start) return 0;
            u32 delta = this.U16(deltas + 2 * i as usize);
            usize ro = ranges + 2 * i as usize;
            u32 range = this.U16(ro);
            if (range == 0) return this.Valid((c + delta) & 0xFFFF);
            u32 g = this.U16(ro + range as usize + 2 * (c - start) as usize);
            if (g == 0) return 0;
            return this.Valid((g + delta) & 0xFFFF);
        }
        return 0;
    }

    u32 Valid(in this, u32 g) {
        if (g >= this.Glyphs) return 0;
        return g;
    }

    // How far the pen moves after glyph g, in font units.
    public i32 Advance(in this, u32 g) {
        u32 i = g;
        if (i >= this.Metrics) i = this.Metrics - 1;
        return this.U16(this.Hmtx + 4 * i as usize) as i32;
    }

    // The glyph for code point c, through the cache.
    u32 GlyphOf(in this, u32 c) {
        if (this.Cache == 0) return this.GlyphIndex(c);
        unsafe {
            *GlyphCache gc = this.Cache as *GlyphCache;
            u64 v = gc[0].Index.GetOr(c as u64, 0);
            if (v != 0) return (v - 1) as u32;
            u32 g = this.GlyphIndex(c);
            gc[0].Index.Set(c as u64, g as u64 + 1);
            return g;
        }
    }

    // How wide text is at size px (pixels per em), in pixels, rounded up.
    public i32 Measure(in this, str t, u32 px) {
        i64 w = 0;
        usize i = 0;
        while (i < t.Len) {
            u32 c = NextChar(t, ref i);
            w += this.Advance(this.GlyphOf(c)) as i64 * px as i64 * 256 / this.Upem as i64;
        }
        return ((w + 255) / 256) as i32;
    }

    // The height of a line at size px: ascent - descent + line gap, in pixels.
    public i32 LineHeight(in this, u32 px) => ((this.Asc - this.Desc + this.Gap) as i64 * px as i64 / this.Upem as i64) as i32;

    // ---------------------------------------------------------------- outlines

    // glyph g's points, contour by contour (ends[k] is one past contour k's last point),
    // with a composite's parts placed; false if the glyph is malformed.
    bool Outline(in this, u32 g, ref List<Pt> pts, ref List<usize> ends, u32 depth) {
        if (depth > MAX_DEPTH || g >= this.Glyphs) return false;
        usize start = 0;
        usize next = 0;
        if (this.LongLoca) {
            start = this.U32(this.Loca + 4 * g as usize) as usize;
            next = this.U32(this.Loca + 4 * g as usize + 4) as usize;
        } else {
            start = 2 * this.U16(this.Loca + 2 * g as usize) as usize;
            next = 2 * this.U16(this.Loca + 2 * g as usize + 2) as usize;
        }
        if (next <= start) return true;         // an empty glyph (a space)
        if (next > this.GlyfLen) return false;
        usize at = this.Glyf + start;
        i32 contours = this.I16(at);
        if (contours >= 0) return this.Simple(at, contours as u32, ref pts, ref ends);
        // composite: parts, each a glyph moved (and perhaps scaled)
        usize p = at + 10;
        while (true) {
            u32 flags = this.U16(p);
            u32 part = this.U16(p + 2);
            p += 4;
            i32 dx = 0;
            i32 dy = 0;
            if (flags & 1 != 0) {
                dx = this.I16(p);
                dy = this.I16(p + 2);
                p += 4;
            } else {
                dx = this.U8(p) as u8 as i8 as i32;
                dy = this.U8(p + 1) as u8 as i8 as i32;
                p += 2;
            }
            if (flags & 2 == 0) {
                dx = 0;     // point matching: not supported, placed unmoved
                dy = 0;
            }
            // a 2x2 transform in F2Dot14
            i32 xx = 16384;
            i32 xy = 0;
            i32 yx = 0;
            i32 yy = 16384;
            if (flags & 0x8 != 0) {
                xx = this.I16(p);
                yy = xx;
                p += 2;
            } else if (flags & 0x40 != 0) {
                xx = this.I16(p);
                yy = this.I16(p + 2);
                p += 4;
            } else if (flags & 0x80 != 0) {
                xx = this.I16(p);
                xy = this.I16(p + 2);
                yx = this.I16(p + 4);
                yy = this.I16(p + 6);
                p += 8;
            }
            usize first = pts.Len();
            if (!this.Outline(part, ref pts, ref ends, depth + 1)) return false;
            Pt[] all = pts.AsSlice();
            List<Pt> moved = List<Pt>.New();
            for (usize i = 0; i < all.Len; i++) {
                Pt q = all[i];
                if (i >= first) {
                    i64 nx = (q.X as i64 * xx as i64 + q.Y as i64 * yx as i64) / 16384 + dx as i64;
                    i64 ny = (q.X as i64 * xy as i64 + q.Y as i64 * yy as i64) / 16384 + dy as i64;
                    q = new Pt { X = nx as i32, Y = ny as i32, On = q.On };
                }
                moved.Push(q);
            }
            pts = moved;
            if (flags & 0x20 == 0) break;
            if (p >= this.Glyf + this.GlyfLen) return false;
        }
        return true;
    }

    bool Simple(in this, usize at, u32 contours, ref List<Pt> pts, ref List<usize> ends) {
        usize base0 = pts.Len();
        usize n = 0;
        for (u32 k = 0; k < contours; k++) {
            usize e = this.U16(at + 10 + 2 * k as usize) as usize + 1;
            if (e <= n && k > 0) return false;     // ends must increase
            n = e;
        }
        if (n == 0) return true;
        if (base0 + n > MAX_POINTS) return false;
        usize p = at + 10 + 2 * contours as usize;
        usize instructions = this.U16(p) as usize;
        p += 2 + instructions;
        // flags, with repeats
        List<u8> flags = List<u8>.New();
        while (flags.Len() < n) {
            if (p >= this.D.Len()) return false;
            u8 fl = this.U8(p) as u8;
            p++;
            flags.Push(fl);
            if (fl & 8 != 0) {
                u32 times = this.U8(p);
                p++;
                for (u32 r = 0; r < times && flags.Len() < n; r++) flags.Push(fl);
            }
        }
        u8[] fs = flags.AsSlice();
        List<i32> xs = List<i32>.New();
        i32 x = 0;
        for (usize i = 0; i < n; i++) {
            u8 fl = fs[i];
            if (fl & 2 != 0) {
                i32 v = this.U8(p) as i32;
                p++;
                if (fl & 16 != 0) x += v;
                else x -= v;
            } else if (fl & 16 == 0) {
                x += this.I16(p);
                p += 2;
            }
            xs.Push(x);
        }
        i32 y = 0;
        u32 k = 0;
        usize endK = this.U16(at + 10) as usize + 1;
        for (usize i = 0; i < n; i++) {
            u8 fl = fs[i];
            if (fl & 4 != 0) {
                i32 v = this.U8(p) as i32;
                p++;
                if (fl & 32 != 0) y += v;
                else y -= v;
            } else if (fl & 32 == 0) {
                y += this.I16(p);
                p += 2;
            }
            pts.Push(new Pt { X = xs.Get(i), Y = y, On = fl & 1 != 0 });
            if (i + 1 == endK) {
                ends.Push(base0 + i + 1);
                k++;
                if (k < contours) endK = this.U16(at + 10 + 2 * k as usize) as usize + 1;
            }
        }
        return true;
    }

    // ---------------------------------------------------------------- rendering

    // Glyph g's coverage at size px (pixels per em), its pen position moved right by
    // shift/256 of a pixel (0-255).
    public Mask Render(in this, u32 g, u32 px, u32 shift) {
        Mask empty = new Mask { W = 0, H = 0, L = 0, T = 0, A = List<u8>.New() };
        List<Pt> pts = List<Pt>.New();
        List<usize> ends = List<usize>.New();
        if (!this.Outline(g, ref pts, ref ends, 0) || pts.Len() == 0) return empty;
        // font units to 1/256 pixel, y down from the baseline
        List<Seg> segs = List<Seg>.New();
        Pt[] all = pts.AsSlice();
        usize[] cs = ends.AsSlice();
        i64 scale = px as i64 * 256;
        i64 upem = this.Upem as i64;
        usize from = 0;
        for (usize k = 0; k < cs.Len; k++) {
            usize to = cs[k];
            if (to > all.Len || to <= from) {
                from = to;
                continue;
            }
            Flatten(all[from..to], scale, upem, shift as i64, ref segs);
            from = to;
        }
        Seg[] ss = segs.AsSlice();
        if (ss.Len == 0) return empty;
        i64 minX = ss[0].X0;
        i64 maxX = ss[0].X0;
        i64 minY = ss[0].Y0;
        i64 maxY = ss[0].Y0;
        for (usize i = 0; i < ss.Len; i++) {
            minX = Min64(minX, Min64(ss[i].X0, ss[i].X1));
            maxX = Max64(maxX, Max64(ss[i].X0, ss[i].X1));
            minY = Min64(minY, Min64(ss[i].Y0, ss[i].Y1));
            maxY = Max64(maxY, Max64(ss[i].Y0, ss[i].Y1));
        }
        i64 left = Floor256(minX);
        i64 top = Floor256(minY);
        i64 w = Floor256(maxX + 255) - left;
        i64 h = Floor256(maxY + 255) - top;
        if (w <= 0 || h <= 0 || w > 4096 || h > 4096) return empty;
        List<i32> acc = List<i32>.New();
        for (i64 i = 0; i < w * h; i++) acc.Push(0);
        mut i32[] cov = acc.AsMutSlice();
        List<i64> xs = List<i64>.New();
        List<i32> dirs = List<i32>.New();
        for (i64 row = 0; row < h; row++) {
            for (i64 sub = 0; sub < 4; sub++) {
                i64 sy = (top + row) * 256 + 32 + 64 * sub;
                xs = List<i64>.New();
                dirs = List<i32>.New();
                for (usize i = 0; i < ss.Len; i++) {
                    Seg s = ss[i];
                    if (s.Y0 == s.Y1) continue;
                    i64 y0 = Min64(s.Y0, s.Y1);
                    i64 y1 = Max64(s.Y0, s.Y1);
                    if (sy < y0 || sy >= y1) continue;
                    i64 x = s.X0 + (sy - s.Y0) * (s.X1 - s.X0) / (s.Y1 - s.Y0);
                    i32 d = 1;
                    if (s.Y1 < s.Y0) d = -1;
                    // insert in order of x
                    xs.Push(x);
                    dirs.Push(d);
                    mut i64[] xm = xs.AsMutSlice();
                    mut i32[] dm = dirs.AsMutSlice();
                    usize j = xm.Len - 1;
                    while (j > 0 && xm[j - 1] > xm[j]) {
                        i64 tx = xm[j - 1];
                        xm[j - 1] = xm[j];
                        xm[j] = tx;
                        i32 td = dm[j - 1];
                        dm[j - 1] = dm[j];
                        dm[j] = td;
                        j--;
                    }
                }
                i64[] xv = xs.AsSlice();
                i32[] dv = dirs.AsSlice();
                i32 wind = 0;
                for (usize i = 0; i + 1 < xv.Len; i++) {
                    wind += dv[i];
                    if (wind == 0) continue;
                    Span(cov, (row * w) as usize, w, xv[i] - left * 256, xv[i + 1] - left * 256);
                }
            }
        }
        List<u8> a = List<u8>.New();
        i32[] cv = acc.AsSlice();
        for (usize i = 0; i < cv.Len; i++) {
            i32 v = cv[i];
            if (v < 0) v = 0;
            if (v > 1024) v = 1024;
            a.Push(((v * 255 + 512) / 1024) as u8);
        }
        return new Mask { W = w as i32, H = h as i32, L = left as i32, T = top as i32, A = a };
    }

    // Draws text on c with its baseline at y, starting at x, at size px, in color.
    // Returns the x after it.
    public i32 Draw(in this, ref gfx.Canvas c, i32 x, i32 y, str t, u32 px, gfx.Color color) {
        i64 pen = x as i64 * 256;
        usize i = 0;
        u32 ca = color.Alpha() as u32;
        while (i < t.Len) {
            u32 ch = NextChar(t, ref i);
            u32 g = this.GlyphOf(ch);
            u32 shift = (pen & 255) as u32;
            if (this.Cache == 0) {
                Mask m = this.Render(g, px, shift);
                BlitMask(ref c, m.A.AsSlice(), m.W, m.H, (pen >> 8) as i32 + m.L, y + m.T, color, ca);
            } else {
                unsafe {
                    *GlyphCache gc = this.Cache as *GlyphCache;
                    u64 key = g as u64 | (px as u64) << 24 | (shift as u64) << 48;
                    u64 slot = gc[0].Slots.GetOr(key, 0);
                    if (slot == 0) {
                        gc[0].Masks.Push(this.Render(g, px, shift));
                        slot = gc[0].Masks.Len() as u64;
                        gc[0].Slots.Set(key, slot);
                    }
                    Mask[] ms = gc[0].Masks.AsSlice();
                    usize k = (slot - 1) as usize;
                    BlitMask(ref c, ms[k].A.AsSlice(), ms[k].W, ms[k].H, (pen >> 8) as i32 + ms[k].L, y + ms[k].T, color, ca);
                }
            }
            pen += this.Advance(g) as i64 * px as i64 * 256 / this.Upem as i64;
        }
        return ((pen + 255) >> 8) as i32;
    }
}

// Draws coverage a (w x h) at (ox, oy) in color.
void BlitMask(ref gfx.Canvas c, u8[] a, i32 w, i32 h, i32 ox, i32 oy, gfx.Color color, u32 ca) {
    c.BlendMask(a, w, h, ox, oy, color);
}

// b's bytes in a new list, copied at once.
List<u8> CopyBytes(u8[] b) {
    List<u8> d = List<u8>.New();
    if (b.Len == 0) return d;
    unsafe {
        d.Data = alloc(b.Len);
        for (usize i = 0; i < b.Len; i++) d.Data[i] = b[i];
        d.Count = b.Len;
        d.Cap = b.Len;
    }
    return d;
}

// The font file at path.
public Result<Font, string> Load(str path) {
    var r = fs.ReadText(path);
    if (r.IsErr()) {
        string e = string.From("cannot read ");
        e.Append(path);
        return Err(e);
    }
    string data = r.Unwrap();
    return Font.ParseText(data.AsStr());
}

// A font the system has: "sans-serif", "serif" or "monospace". EnvoL bundles no fonts;
// this looks in the usual places on Windows and Linux.
public Result<Font, string> System(str family) {
    List<str> paths = List<str>.New();
    if (Same(family, "monospace")) {
        paths.Push("C:/Windows/Fonts/consola.ttf");
        paths.Push("C:/Windows/Fonts/cour.ttf");
        paths.Push("/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf");
        paths.Push("/usr/share/fonts/dejavu/DejaVuSansMono.ttf");
        paths.Push("/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf");
        paths.Push("/usr/share/fonts/liberation-mono/LiberationMono-Regular.ttf");
    } else if (Same(family, "serif")) {
        paths.Push("C:/Windows/Fonts/times.ttf");
        paths.Push("C:/Windows/Fonts/georgia.ttf");
        paths.Push("/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf");
        paths.Push("/usr/share/fonts/dejavu/DejaVuSerif.ttf");
        paths.Push("/usr/share/fonts/truetype/liberation/LiberationSerif-Regular.ttf");
    } else {
        paths.Push("C:/Windows/Fonts/segoeui.ttf");
        paths.Push("C:/Windows/Fonts/arial.ttf");
        paths.Push("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf");
        paths.Push("/usr/share/fonts/dejavu/DejaVuSans.ttf");
        paths.Push("/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf");
        paths.Push("/usr/share/fonts/truetype/noto/NotoSans-Regular.ttf");
    }
    str[] ps = paths.AsSlice();
    for (usize i = 0; i < ps.Len; i++) {
        if (!fs.IsFile(ps[i])) continue;
        Result<Font, string> f = Load(ps[i]);
        if (f.IsOk()) return f;
    }
    string e = string.From("no ");
    e.Append(family);
    e.Append(" font found on this system");
    return Err(e);
}

bool Same(str a, str b) {
    if (a.Len != b.Len) return false;
    for (usize i = 0; i < a.Len; i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// Adds coverage for the span [xa, xb) (1/256 pixel, from the mask's left edge) to the
// row starting at cov[at], which is w pixels wide.
void Span(mut i32[] cov, usize at, i64 w, i64 xa0, i64 xb0) {
    i64 xa = Max64(xa0, 0);
    i64 xb = Min64(xb0, w * 256);
    if (xb <= xa) return;
    i64 pa = xa >> 8;
    i64 pb = xb >> 8;
    if (pa == pb) {
        cov[at + pa as usize] += (xb - xa) as i32;
        return;
    }
    cov[at + pa as usize] += (256 - (xa & 255)) as i32;
    for (i64 p = pa + 1; p < pb; p++) cov[at + p as usize] += 256;
    if (pb < w) cov[at + pb as usize] += (xb & 255) as i32;
}

// One contour's points as lines in 1/256 pixel: on-curve points joined by lines,
// off-curve points as quadratic curves (two off-curve points in a row have an on-curve
// point between them).
void Flatten(Pt[] c, i64 scale, i64 upem, i64 shift, ref List<Seg> segs) {
    usize n = c.Len;
    // start on an on-curve point (or the midpoint of the first two off-curve ones)
    usize s = n;
    for (usize i = 0; i < n; i++) {
        if (c[i].On) {
            s = i;
            break;
        }
    }
    i64 sx = 0;
    i64 sy = 0;
    if (s == n) {
        sx = (c[0].X as i64 + c[1 % n].X as i64) / 2;
        sy = (c[0].Y as i64 + c[1 % n].Y as i64) / 2;
        s = 0;
    } else {
        sx = c[s].X as i64;
        sy = c[s].Y as i64;
    }
    i64 cx = sx;
    i64 cy = sy;
    bool pending = false;       // an off-curve control point waits
    i64 qx = 0;
    i64 qy = 0;
    for (usize k = 1; k <= n; k++) {
        Pt p = c[(s + k) % n];
        i64 px = p.X as i64;
        i64 py = p.Y as i64;
        if (p.On) {
            if (pending) {
                Curve(cx, cy, qx, qy, px, py, scale, upem, shift, ref segs);
            } else {
                Line(cx, cy, px, py, scale, upem, shift, ref segs);
            }
            cx = px;
            cy = py;
            pending = false;
        } else if (pending) {
            i64 mx = (qx + px) / 2;
            i64 my = (qy + py) / 2;
            Curve(cx, cy, qx, qy, mx, my, scale, upem, shift, ref segs);
            cx = mx;
            cy = my;
            qx = px;
            qy = py;
        } else {
            qx = px;
            qy = py;
            pending = true;
        }
    }
    if (pending) Curve(cx, cy, qx, qy, sx, sy, scale, upem, shift, ref segs);
    else if (cx != sx || cy != sy) Line(cx, cy, sx, sy, scale, upem, shift, ref segs);
}

i64 SX(i64 x, i64 scale, i64 upem, i64 shift) => x * scale / upem + shift;
i64 SY(i64 y, i64 scale, i64 upem) => 0 - y * scale / upem;

void Line(i64 x0, i64 y0, i64 x1, i64 y1, i64 scale, i64 upem, i64 shift, ref List<Seg> segs) {
    segs.Push(new Seg { X0 = SX(x0, scale, upem, shift), Y0 = SY(y0, scale, upem), X1 = SX(x1, scale, upem, shift), Y1 = SY(y1, scale, upem) });
}

void Curve(i64 x0, i64 y0, i64 qx, i64 qy, i64 x1, i64 y1, i64 scale, i64 upem, i64 shift, ref List<Seg> segs) {
    i64 ax = SX(x0, scale, upem, shift);
    i64 ay = SY(y0, scale, upem);
    i64 bx = SX(qx, scale, upem, shift);
    i64 by = SY(qy, scale, upem);
    i64 ex = SX(x1, scale, upem, shift);
    i64 ey = SY(y1, scale, upem);
    // steps by the control polygon's length: about one per 2 pixels, 1 to 32
    i64 len = Abs64(bx - ax) + Abs64(by - ay) + Abs64(ex - bx) + Abs64(ey - by);
    i64 steps = len / 512 + 1;
    if (steps > 32) steps = 32;
    i64 px = ax;
    i64 py = ay;
    i64 nn = steps * steps;
    for (i64 k = 1; k <= steps; k++) {
        i64 u = steps - k;
        i64 x = (u * u * ax + 2 * k * u * bx + k * k * ex) / nn;
        i64 y = (u * u * ay + 2 * k * u * by + k * k * ey) / nn;
        segs.Push(new Seg { X0 = px, Y0 = py, X1 = x, Y1 = y });
        px = x;
        py = y;
    }
}

// The code point at t[i] (UTF-8), moving i past it; U+FFFD for a byte that starts none.
u32 NextChar(str t, ref usize i) {
    u8 b = t[i];
    usize n = 1;
    u32 c = b as u32;
    if (b >= 0xF0 && b < 0xF8) {
        n = 4;
        c = (b & 0x07) as u32;
    } else if (b >= 0xE0) {
        n = 3;
        c = (b & 0x0F) as u32;
    } else if (b >= 0xC0) {
        n = 2;
        c = (b & 0x1F) as u32;
    } else if (b >= 0x80) {
        i = i + 1;
        return 0xFFFD;
    }
    if (i + n > t.Len) {
        i = t.Len;
        return 0xFFFD;
    }
    for (usize k = 1; k < n; k++) {
        if (t[i + k] & 0xC0 != 0x80) {
            i = i + 1;
            return 0xFFFD;
        }
        c = c << 6 | (t[i + k] & 0x3F) as u32;
    }
    i = i + n;
    return c;
}

i64 Floor256(i64 v) {
    if (v >= 0) return v / 256;
    return 0 - ((255 - v) / 256);
}

i64 Min64(i64 a, i64 b) {
    if (a < b) return a;
    return b;
}

i64 Max64(i64 a, i64 b) {
    if (a > b) return a;
    return b;
}

i64 Abs64(i64 a) {
    if (a < 0) return 0 - a;
    return a;
}
