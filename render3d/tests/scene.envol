// envor.render3d: a scene (a spinning cube, a dielectric and a metal sphere, a ground
// plane, sunlight) rendered in software. The frame is IEEE arithmetic only, so its hash
// is the same at -O0 and -O2, in the script runtime and in WebAssembly. Plus the meshes'
// sizes and the camera's clipping of a triangle through the near plane.
// expect: cube 12 triangles, sphere 512, plane 2
// expect: frame 96x64 88353c2645ce0a04ed23fefb605c3b7a9927d00571aa3f5ae5622ab9f15ab2b3
// expect: near: a triangle through the camera draws without trouble
use envor.render3d;
use envor.math;
use envor.gfx;
use alloc.text;

write(1, "cube ");
write(1, text.Uint(render3d.Mesh.Cube().TriangleCount() as u64).AsStr());
write(1, " triangles, sphere ");
write(1, text.Uint(render3d.Mesh.Sphere(16, 16).TriangleCount() as u64).AsStr());
write(1, ", plane ");
print(text.Uint(render3d.Mesh.Plane(1.0).TriangleCount() as u64).AsStr());

render3d.Scene s = render3d.Scene.New().Cube().Spin().Sun();
s.Step(0.6);
s.Add(render3d.Mesh.Sphere(12, 24), render3d.Material.Rgb(0xFF3B30, 0.0, 0.3), math.Vec3.Of(1.1, 0.0, 0.2));
s.Add(render3d.Mesh.Sphere(12, 24), render3d.Material.Rgb(0xD4AF37, 1.0, 0.25), math.Vec3.Of(-1.1, 0.0, 0.2));
s.Add(render3d.Mesh.Plane(6.0), render3d.Material.Rgb(0xC7C7CC, 0.0, 0.8), math.Vec3.Of(0.0, -0.6, 0.0));
gfx.Canvas c = render3d.Render(s, 96, 64);
write(1, "frame 96x64 ");
print(c.Hash().AsStr());

// a big plane around the camera: its triangles cross the near plane and are clipped
render3d.Scene t = render3d.Scene.New().Sun();
t.Add(render3d.Mesh.Plane(40.0), render3d.Material.Rgb(0x808080, 0.0, 0.5), math.Vec3.Of(0.0, 1.0, 3.0));
gfx.Canvas d = render3d.Render(t, 32, 24);
if (d.Width() == 32) print("near: a triangle through the camera draws without trouble");
