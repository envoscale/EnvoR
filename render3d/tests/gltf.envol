// envor.render3d.gltf: a glTF 2.0 document with a base64 buffer (pyramid.gltf, made by
// hand for this test): two meshes (one without normals, so the importer computes the
// faces'), 16- and 8-bit indices, two metallic-roughness materials, and nodes with
// translation, rotation, scale and children. Plus malformed documents refused.
// expect: meshes 2, parts 2
// expect: pyramid apex at y 0.600
// expect: frame 4714a9cadcde1b21f5564feb28574261a8146563cd8c7590cb9095bc0a8d88e6
// expect: refused: the document is not JSON / an accessor index out of range / an index past the vertices
use envor.render3d;
use envor.render3d.gltf;
use envor.math;
use envor.gfx;
use alloc.text;

// the tests run three folders below the root
gltf.Import im = gltf.Load("../../../render3d/tests/pyramid.gltf").Unwrap();
write(1, "meshes ");
write(1, text.Uint(im.MeshCount() as u64).AsStr());
write(1, ", parts ");
print(text.Uint(im.PartCount() as u64).AsStr());
render3d.Scene s = render3d.Scene.New().Sun();
im.AddTo(ref s);
// the pyramid's apex: (0, 1, 0) scaled 1.2, then moved down 0.6
f32 top = -100.0;
render3d.Mesh[] ms = s.Meshes.AsSlice();
math.Vec3[] ps = ms[0].Positions.AsSlice();
for (usize i = 0; i < ps.Len; i++) {
    if (ps[i].Y > top) top = ps[i].Y;
}
write(1, "pyramid apex at y ");
print(text.Float(top as f64, 3).AsStr());
s.SetCamera(math.Vec3.Of(1.5, 1.0, 2.5), math.Vec3.Of(0.0, -0.1, 0.0));
gfx.Canvas c = render3d.Render(s, 80, 60);
write(1, "frame ");
print(c.Hash().AsStr());
write(1, "refused: ");
write(1, gltf.Parse("{").UnwrapErr().AsStr());
write(1, " / ");
write(1, gltf.Parse("{\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":7}}]}]}").UnwrapErr().AsStr());
write(1, " / ");
print(gltf.Parse("{\"buffers\":[{\"uri\":\"data:,AAAAAAAAAAAAAAAAAAAF\"}],\"bufferViews\":[{\"buffer\":0,\"byteLength\":12},{\"buffer\":0,\"byteOffset\":12,\"byteLength\":3}],\"accessors\":[{\"bufferView\":0,\"componentType\":5126,\"count\":1},{\"bufferView\":1,\"componentType\":5121,\"count\":3}],\"meshes\":[{\"primitives\":[{\"attributes\":{\"POSITION\":0},\"indices\":1}]}]}").UnwrapErr().AsStr());
