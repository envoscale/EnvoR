// envor.render3d: 3D scenes, rendered in software (PLAN D55). A scene is an envor.ecs world
// of objects with a transform, a mesh and a material, lit by directional (sun) and point
// lights and seen by a camera. The renderer clips triangles at the near plane, rasterizes
// them with a depth buffer and perspective-correct interpolation, and shades each pixel
// physically (Cook-Torrance: GGX distribution, Smith-Schlick geometry, Schlick Fresnel),
// then tone-maps (ACES) into sRGB. All of it is IEEE arithmetic in EnvoL, so a frame is
// the same, bit for bit, in every build and in the script runtime.
namespace envor.render3d;

use envor.math;
use envor.gfx;
use envor.ecs;
use core.math as cm;
use ports.{IWindow, EventKind};
use platform;

// ------------------------------------------------------------------ meshes and materials

// Triangles: positions and normals per vertex, three indices per triangle (counter-
// clockwise seen from outside).
public struct Mesh {
    List<math.Vec3> Positions;
    List<math.Vec3> Normals;
    List<u32> Indices;

    public static Mesh New() => new Mesh { Positions = List<math.Vec3>.New(), Normals = List<math.Vec3>.New(), Indices = List<u32>.New() };

    public u32 Vertex(ref this, in math.Vec3 p, in math.Vec3 n) {
        this.Positions.Push(p);
        this.Normals.Push(n);
        return (this.Positions.Len() - 1) as u32;
    }

    public void Triangle(ref this, u32 a, u32 b, u32 c) {
        this.Indices.Push(a);
        this.Indices.Push(b);
        this.Indices.Push(c);
    }

    public usize TriangleCount(in this) => this.Indices.Len() / 3;

    // A cube from -0.5 to 0.5 on each axis, with flat faces.
    public static Mesh Cube() {
        Mesh m = Mesh.New();
        for (i32 axis = 0; axis < 3; axis++) {
            for (i32 sgn = 0; sgn < 2; sgn++) {
                f32 s = 1.0;
                if (sgn == 1) s = -1.0;
                math.Vec3 n = Axis(axis, s);
                math.Vec3 u = Axis((axis + 1) % 3, 1.0);
                math.Vec3 v = Axis((axis + 2) % 3, 1.0);
                if (s < 0.0) {
                    math.Vec3 t = u;
                    u = v;
                    v = t;
                }
                math.Vec3 c = n.Mul(0.5);
                u32 a = m.Vertex(c.Sub(u.Mul(0.5)).Sub(v.Mul(0.5)), n);
                u32 b = m.Vertex(c.Add(u.Mul(0.5)).Sub(v.Mul(0.5)), n);
                u32 d = m.Vertex(c.Add(u.Mul(0.5)).Add(v.Mul(0.5)), n);
                u32 e = m.Vertex(c.Sub(u.Mul(0.5)).Add(v.Mul(0.5)), n);
                m.Triangle(a, b, d);
                m.Triangle(a, d, e);
            }
        }
        return m;
    }

    // A sphere of radius 0.5: rings from pole to pole, segments around.
    public static Mesh Sphere(u32 rings, u32 segments) {
        Mesh m = Mesh.New();
        for (u32 r = 0; r <= rings; r++) {
            f64 th = cm.PI * (r as f64) / (rings as f64);
            for (u32 s = 0; s <= segments; s++) {
                f64 ph = cm.TAU * (s as f64) / (segments as f64);
                math.Vec3 n = math.Vec3.Of((cm.Sin(th) * cm.Cos(ph)) as f32, cm.Cos(th) as f32, (cm.Sin(th) * cm.Sin(ph)) as f32);
                m.Vertex(n.Mul(0.5), n);
            }
        }
        u32 row = segments + 1;
        for (u32 r = 0; r < rings; r++) {
            for (u32 s = 0; s < segments; s++) {
                u32 a = r * row + s;
                u32 b = a + row;
                m.Triangle(a, a + 1, b);
                m.Triangle(a + 1, b + 1, b);
            }
        }
        return m;
    }

    // A square of side size on the y = 0 plane, facing up.
    public static Mesh Plane(f32 size) {
        Mesh m = Mesh.New();
        f32 h = size * 0.5;
        math.Vec3 up = math.Vec3.Up();
        u32 a = m.Vertex(math.Vec3.Of(-h, 0.0, -h), up);
        u32 b = m.Vertex(math.Vec3.Of(-h, 0.0, h), up);
        u32 c = m.Vertex(math.Vec3.Of(h, 0.0, h), up);
        u32 d = m.Vertex(math.Vec3.Of(h, 0.0, -h), up);
        m.Triangle(a, b, c);
        m.Triangle(a, c, d);
        return m;
    }
}

math.Vec3 Axis(i32 axis, f32 s) {
    if (axis == 0) return math.Vec3.Of(s, 0.0, 0.0);
    if (axis == 1) return math.Vec3.Of(0.0, s, 0.0);
    return math.Vec3.Of(0.0, 0.0, s);
}

// How a surface looks: its base color (linear RGB), metal or not, and how rough.
public struct Material {
    math.Vec3 Base;
    f32 Metallic;
    f32 Roughness;
    math.Vec3 Emissive;

    public static Material Of(in math.Vec3 base0, f32 metallic, f32 roughness) => new Material { Base = base0, Metallic = metallic, Roughness = roughness, Emissive = math.Vec3.Zero() };

    // A color from sRGB bytes ("#1a73e8"), made linear.
    public static Material Rgb(u32 rgb, f32 metallic, f32 roughness) => Material.Of(Linear(rgb), metallic, roughness);
}

// sRGB 0xRRGGBB to linear RGB.
public math.Vec3 Linear(u32 rgb) => math.Vec3.Of(Decode((rgb >> 16 & 0xFF) as f32 / 255.0), Decode((rgb >> 8 & 0xFF) as f32 / 255.0), Decode((rgb & 0xFF) as f32 / 255.0));

f32 Decode(f32 c) {
    if (c <= 0.04045) return c / 12.92;
    return cm.PowF(((c + 0.055) / 1.055) as f64, 2.4) as f32;
}

// ------------------------------------------------------------------ the scene

// Where an object is, how it is turned, and its size.
public struct Transform {
    math.Vec3 Position;
    math.Quat Rotation;
    math.Vec3 Scale;

    public static Transform At(in math.Vec3 p) => new Transform { Position = p, Rotation = math.Quat.Identity(), Scale = math.Vec3.One() };
    public math.Mat4 Matrix(in this) => math.Mat4.Trs(this.Position, this.Rotation, this.Scale);
}

// Turning about an axis, radians per second.
public struct Spin {
    math.Vec3 Axis;
    f32 Speed;
}

public const u8 SUN = 1;
public const u8 POINT = 2;

public struct Light {
    u8 Kind;
    math.Vec3 Vector;       // a sun's direction (toward the scene), a point light's position
    math.Vec3 Color;        // linear, times the intensity
}

public struct Camera {
    math.Vec3 Eye;
    math.Vec3 Target;
    f32 FovY;
    f32 Near;
    f32 Far;
}

// A scene: objects (entities with a transform, a mesh and a material), lights, a camera.
// The builder methods take and give the scene, so a scene can be written in one
// expression: Scene.New().Cube().Spin().Sun().
public struct Scene {
    ecs.World World;
    ecs.Store<Transform> Transforms;
    ecs.Store<u32> MeshOf;
    ecs.Store<Material> Materials;
    ecs.Store<Spin> Spins;
    List<Mesh> Meshes;
    List<Light> Lights;
    Camera Cam;
    math.Vec3 Ambient;
    math.Vec3 Sky;
    ecs.Entity Last;        // the object the last builder call added

    public static Scene New() => new Scene {
        World = ecs.World.New(), Transforms = ecs.Store<Transform>.New(), MeshOf = ecs.Store<u32>.New(),
        Materials = ecs.Store<Material>.New(), Spins = ecs.Store<Spin>.New(), Meshes = List<Mesh>.New(),
        Lights = List<Light>.New(),
        Cam = new Camera { Eye = math.Vec3.Of(0.0, 1.2, 3.0), Target = math.Vec3.Zero(), FovY = math.Radians(50.0), Near = 0.1, Far = 100.0 },
        Ambient = math.Vec3.Of(0.03, 0.03, 0.035), Sky = Linear(0xF5F5F7), Last = ecs.Entity.None(),
    };

    // An object with mesh m and material mat at position p. Returns its entity.
    public ecs.Entity Add(ref this, Mesh m, in Material mat, in math.Vec3 p) {
        ecs.Entity e = this.World.Spawn();
        this.Meshes.Push(m);
        this.MeshOf.Set(e, (this.Meshes.Len() - 1) as u32);
        this.Transforms.Set(e, Transform.At(p));
        this.Materials.Set(e, mat);
        this.Last = e;
        return e;
    }

    public void AddLight(ref this, Light l) {
        this.Lights.Push(l);
    }

    public void SetCamera(ref this, in math.Vec3 eye, in math.Vec3 target) {
        this.Cam.Eye = eye;
        this.Cam.Target = target;
    }

    public void SetTransform(ref this, ecs.Entity e, in Transform t) {
        this.Transforms.Set(e, t);
    }

    public void SetSpin(ref this, ecs.Entity e, in math.Vec3 axis, f32 speed) {
        this.Spins.Set(e, new Spin { Axis = axis, Speed = speed });
    }

    // Advances spinning objects by dt seconds.
    public void Step(ref this, f32 dt) {
        ecs.Entity[] owners = this.Spins.Entities();
        Spin[] spins = this.Spins.Values();
        for (usize i = 0; i < owners.Len; i++) {
            usize at = this.Transforms.Find(owners[i]);
            if (at >= this.Transforms.Len()) continue;
            mut Transform[] ts = this.Transforms.ValuesMut();
            math.Quat turn = math.Quat.Axis(spins[i].Axis, spins[i].Speed * dt);
            ts[at].Rotation = turn.Mul(ts[at].Rotation).Normalize();
        }
    }

    // ---------------------------------------------------------------- the simple door

    // A blue cube at the centre.
    public Scene Cube(this) {
        Scene s = this;
        s.Add(Mesh.Cube(), Material.Rgb(0x1A73E8, 0.0, 0.35), math.Vec3.Zero());
        return s;
    }

    // A sphere at the centre.
    public Scene Ball(this) {
        Scene s = this;
        s.Add(Mesh.Sphere(16, 32), Material.Rgb(0xFF3B30, 0.0, 0.4), math.Vec3.Zero());
        return s;
    }

    // The last object turns about a tilted axis.
    public Scene Spin(this) {
        Scene s = this;
        if (!s.Last.IsNone()) s.SetSpin(s.Last, math.Vec3.Of(0.3, 1.0, 0.1), 0.8);
        return s;
    }

    // Sunlight from the upper left, and a soft fill from behind the camera.
    public Scene Sun(this) {
        Scene s = this;
        s.AddLight(new Light { Kind = SUN, Vector = math.Vec3.Of(-0.5, -1.0, -0.6).Normalize(), Color = math.Vec3.Of(3.2, 3.0, 2.8) });
        s.AddLight(new Light { Kind = SUN, Vector = math.Vec3.Of(0.4, -0.2, -1.0).Normalize(), Color = math.Vec3.Of(0.35, 0.38, 0.45) });
        return s;
    }
}

// ------------------------------------------------------------------ rendering

// A vertex after the vertex stage: clip position, world position and normal.
struct Clip {
    math.Vec4 C;
    math.Vec3 P;
    math.Vec3 N;
}

Clip LerpClip(in Clip a, in Clip b, f32 t) => new Clip {
    C = math.Vec4.Of(a.C.X + (b.C.X - a.C.X) * t, a.C.Y + (b.C.Y - a.C.Y) * t, a.C.Z + (b.C.Z - a.C.Z) * t, a.C.W + (b.C.W - a.C.W) * t),
    P = a.P.Lerp(b.P, t), N = a.N.Lerp(b.N, t),
};

// Renders scene into a width x height canvas.
public gfx.Canvas Render(in Scene scene, i32 width, i32 height) {
    gfx.Canvas c = gfx.Canvas.New(width, height);
    Frame f = Frame.New(width, height);
    f.Draw(scene);
    f.Resolve(ref c, scene.Sky);
    return c;
}

// The frame being drawn: linear color and depth per pixel.
struct Frame {
    i32 W;
    i32 H;
    List<f32> Depth;
    List<math.Vec3> Color;
    List<u8> Srgb;          // linear [0, 1] in 4096 steps to sRGB bytes

    static Frame New(i32 w, i32 h) {
        Frame f = new Frame { W = w, H = h, Depth = List<f32>.New(), Color = List<math.Vec3>.New(), Srgb = List<u8>.New() };
        for (i32 i = 0; i < w * h; i++) {
            f.Depth.Push(1.0);
            f.Color.Push(math.Vec3.Of(-1.0, 0.0, 0.0));     // x < 0: sky
        }
        for (i32 i = 0; i < 4096; i++) {
            f64 x = (i as f64) / 4095.0;
            f64 s = 12.92 * x;
            if (x > 0.0031308) s = 1.055 * cm.PowF(x, 1.0 / 2.4) - 0.055;
            f.Srgb.Push(cm.Round(cm.FClamp(s, 0.0, 1.0) * 255.0) as u8);
        }
        return f;
    }

    void Draw(ref this, in Scene scene) {
        f32 aspect = (this.W as f32) / (this.H as f32);
        math.Mat4 view = math.Mat4.LookAt(scene.Cam.Eye, scene.Cam.Target, math.Vec3.Up());
        math.Mat4 proj = math.Mat4.Perspective(scene.Cam.FovY, aspect, scene.Cam.Near, scene.Cam.Far);
        math.Mat4 vp = proj.Mul(view);
        ecs.Entity[] owners = scene.MeshOf.Entities();
        u32[] meshIds = scene.MeshOf.Values();
        Mesh[] meshes = scene.Meshes.AsSlice();
        for (usize k = 0; k < owners.Len; k++) {
            ecs.Entity e = owners[k];
            if (!scene.Transforms.Has(e) || !scene.Materials.Has(e)) continue;
            math.Mat4 model = scene.Transforms.Get(e).Matrix();
            math.Mat4 normalM = model.Inverse().Transpose();
            math.Mat4 mvp = vp.Mul(model);
            Material mat = scene.Materials.Get(e);
            usize mi = meshIds[k] as usize;
            math.Vec3[] ps = meshes[mi].Positions.AsSlice();
            math.Vec3[] ns = meshes[mi].Normals.AsSlice();
            u32[] ix = meshes[mi].Indices.AsSlice();
            for (usize t = 0; t + 2 < ix.Len; t += 3) {
                Clip a = Vertex(mvp, model, normalM, ps[ix[t] as usize], ns[ix[t] as usize]);
                Clip b = Vertex(mvp, model, normalM, ps[ix[t + 1] as usize], ns[ix[t + 1] as usize]);
                Clip c = Vertex(mvp, model, normalM, ps[ix[t + 2] as usize], ns[ix[t + 2] as usize]);
                this.ClipNear(a, b, c, scene, mat);
            }
        }
    }

    // Clips the triangle against the near plane (clip z >= 0), then rasterizes.
    void ClipNear(ref this, in Clip a, in Clip b, in Clip c, in Scene scene, in Material mat) {
        bool ia = a.C.Z >= 0.0;
        bool ib = b.C.Z >= 0.0;
        bool ic = c.C.Z >= 0.0;
        if (ia && ib && ic) {
            this.Raster(a, b, c, scene, mat);
            return;
        }
        if (!ia && !ib && !ic) return;
        // rotate so that the odd one out comes first
        if (ia == ib) this.ClipOrdered(c, a, b, ic, scene, mat);
        else if (ia == ic) this.ClipOrdered(b, c, a, ib, scene, mat);
        else this.ClipOrdered(a, b, c, ia, scene, mat);
    }

    // a is on one side of the plane, b and c on the other; aIn says which.
    void ClipOrdered(ref this, in Clip a, in Clip b, in Clip c, bool aIn, in Scene scene, in Material mat) {
        f32 tb = a.C.Z / (a.C.Z - b.C.Z);
        f32 tc = a.C.Z / (a.C.Z - c.C.Z);
        Clip ab = LerpClip(a, b, tb);
        Clip ac = LerpClip(a, c, tc);
        if (aIn) {
            this.Raster(a, ab, ac, scene, mat);
        } else {
            this.Raster(ab, b, c, scene, mat);
            this.Raster(ab, c, ac, scene, mat);
        }
    }

    void Raster(ref this, in Clip a, in Clip b, in Clip c, in Scene scene, in Material mat) {
        // screen positions; 1/w for perspective-correct interpolation
        f32 wa = 1.0 / a.C.W;
        f32 wb = 1.0 / b.C.W;
        f32 wc = 1.0 / c.C.W;
        f32 ax = (a.C.X * wa + 1.0) * 0.5 * (this.W as f32);
        f32 ay = (1.0 - a.C.Y * wa) * 0.5 * (this.H as f32);
        f32 bx = (b.C.X * wb + 1.0) * 0.5 * (this.W as f32);
        f32 by = (1.0 - b.C.Y * wb) * 0.5 * (this.H as f32);
        f32 cx = (c.C.X * wc + 1.0) * 0.5 * (this.W as f32);
        f32 cy = (1.0 - c.C.Y * wc) * 0.5 * (this.H as f32);
        f32 area = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax);
        // counter-clockwise in the world is clockwise on a y-down screen, which this area
        // measures as negative: a positive area is a face turned away
        if (area >= 0.0) return;
        f32 za = a.C.Z * wa;
        f32 zb = b.C.Z * wb;
        f32 zc = c.C.Z * wc;
        i32 x0 = Max(Floor(Min3(ax, bx, cx)), 0);
        i32 x1 = Min(Ceil(Max3(ax, bx, cx)), this.W - 1);
        i32 y0 = Max(Floor(Min3(ay, by, cy)), 0);
        i32 y1 = Min(Ceil(Max3(ay, by, cy)), this.H - 1);
        f32 inv = 1.0 / area;
        for (i32 y = y0; y <= y1; y++) {
            f32 py = y as f32 + 0.5;
            for (i32 x = x0; x <= x1; x++) {
                f32 px = x as f32 + 0.5;
                f32 w0 = ((cx - bx) * (py - by) - (cy - by) * (px - bx)) * inv;
                f32 w1 = ((ax - cx) * (py - cy) - (ay - cy) * (px - cx)) * inv;
                f32 w2 = 1.0 - w0 - w1;
                if (w0 < 0.0 || w1 < 0.0 || w2 < 0.0) continue;
                f32 z = w0 * za + w1 * zb + w2 * zc;
                usize at = (y * this.W + x) as usize;
                if (z < 0.0 || z >= this.Depth.Get(at)) continue;
                // perspective-correct weights
                f32 pa = w0 * wa;
                f32 pb = w1 * wb;
                f32 pc = w2 * wc;
                f32 ps = 1.0 / (pa + pb + pc);
                pa = pa * ps;
                pb = pb * ps;
                pc = pc * ps;
                math.Vec3 pos = a.P.Mul(pa).Add(b.P.Mul(pb)).Add(c.P.Mul(pc));
                math.Vec3 n = a.N.Mul(pa).Add(b.N.Mul(pb)).Add(c.N.Mul(pc)).Normalize();
                this.Depth.Set(at, z);
                this.Color.Set(at, Shade(scene, mat, pos, n));
            }
        }
    }

    // Tone-maps and writes the frame into c; uncovered pixels take the sky color.
    void Resolve(ref this, ref gfx.Canvas c, in math.Vec3 sky) {
        math.Vec3[] col = this.Color.AsSlice();
        u8[] lut = this.Srgb.AsSlice();
        for (i32 y = 0; y < this.H; y++) {
            for (i32 x = 0; x < this.W; x++) {
                math.Vec3 v = col[(y * this.W + x) as usize];
                if (v.X < 0.0) v = sky;
                else v = math.Vec3.Of(Aces(v.X), Aces(v.Y), Aces(v.Z));
                c.Blend(x, y, gfx.Color.Rgb(lut[Lut(v.X)], lut[Lut(v.Y)], lut[Lut(v.Z)]));
            }
        }
    }
}

usize Lut(f32 v) {
    f32 c = v;
    if (c < 0.0) c = 0.0;
    if (c > 1.0) c = 1.0;
    return (c * 4095.0 + 0.5) as usize;
}

// ACES filmic tone mapping (Narkowicz's fit).
f32 Aces(f32 x) {
    f32 r = (x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14);
    if (r < 0.0) return 0.0;
    if (r > 1.0) return 1.0;
    return r;
}

Clip Vertex(in math.Mat4 mvp, in math.Mat4 model, in math.Mat4 normalM, in math.Vec3 p, in math.Vec3 n) => new Clip {
    C = mvp.MulVec4(math.Vec4.Point(p)), P = model.TransformPoint(p), N = normalM.TransformDir(n).Normalize(),
};

// The light leaving point p (normal n) toward the camera: Cook-Torrance.
math.Vec3 Shade(in Scene scene, in Material mat, in math.Vec3 p, in math.Vec3 n) {
    math.Vec3 v = scene.Cam.Eye.Sub(p).Normalize();
    f32 nv = Max0(n.Dot(v)) + 0.0001;
    f32 rough = mat.Roughness;
    if (rough < 0.04) rough = 0.04;
    f32 alpha = rough * rough;
    f32 a2 = alpha * alpha;
    f32 k = (rough + 1.0) * (rough + 1.0) / 8.0;
    math.Vec3 f0 = math.Vec3.Of(0.04, 0.04, 0.04).Lerp(mat.Base, mat.Metallic);
    math.Vec3 diffuse = mat.Base.Mul((1.0 - mat.Metallic) / (cm.PI as f32));
    // the environment: a hemisphere, the sky's light above and a darker ground below, lit
    // diffusely and reflected by the Fresnel term (so metals show their color)
    math.Vec3 skyLight = scene.Sky.Mul(0.35);
    math.Vec3 groundLight = scene.Ambient;
    math.Vec3 envDiffuse = groundLight.Lerp(skyLight, 0.5 + 0.5 * n.Y);
    math.Vec3 r = v.Neg().Reflect(n);
    math.Vec3 envSpecular = groundLight.Lerp(skyLight, 0.5 + 0.5 * r.Y);
    math.Vec3 fEnv = f0.Add(math.Vec3.One().Sub(f0).Mul(Pow5(1.0 - nv) * (1.0 - rough)));
    math.Vec3 sum = envDiffuse.Scale(mat.Base).Mul(1.0 - mat.Metallic).Add(envSpecular.Scale(fEnv)).Add(mat.Emissive);
    Light[] ls = scene.Lights.AsSlice();
    for (usize i = 0; i < ls.Len; i++) {
        math.Vec3 l = ls[i].Vector.Neg();
        math.Vec3 radiance = ls[i].Color;
        if (ls[i].Kind == POINT) {
            math.Vec3 d = ls[i].Vector.Sub(p);
            f32 dist2 = d.Dot(d);
            l = d.Normalize();
            radiance = ls[i].Color.Mul(1.0 / (dist2 + 0.0001));
        }
        f32 nl = n.Dot(l);
        if (nl <= 0.0) continue;
        math.Vec3 h = v.Add(l).Normalize();
        f32 nh = Max0(n.Dot(h));
        f32 hv = Max0(h.Dot(v));
        f32 dd = nh * nh * (a2 - 1.0) + 1.0;
        f32 d = a2 / ((cm.PI as f32) * dd * dd);
        f32 g = (nv / (nv * (1.0 - k) + k)) * (nl / (nl * (1.0 - k) + k));
        f32 fw = Pow5(1.0 - hv);
        math.Vec3 f = f0.Add(math.Vec3.One().Sub(f0).Mul(fw));
        math.Vec3 spec = f.Mul(d * g / (4.0 * nv * nl + 0.0001));
        math.Vec3 kd = math.Vec3.One().Sub(f);
        sum = sum.Add(kd.Scale(diffuse).Add(spec).Scale(radiance).Mul(nl));
    }
    return sum;
}

f32 Pow5(f32 x) {
    f32 x2 = x * x;
    return x2 * x2 * x;
}

f32 Max0(f32 x) {
    if (x < 0.0) return 0.0;
    return x;
}

f32 Min3(f32 a, f32 b, f32 c) {
    f32 m = a;
    if (b < m) m = b;
    if (c < m) m = c;
    return m;
}

f32 Max3(f32 a, f32 b, f32 c) {
    f32 m = a;
    if (b > m) m = b;
    if (c > m) m = c;
    return m;
}

i32 Floor(f32 x) => cm.Floor(x as f64) as i32;
i32 Ceil(f32 x) => cm.Ceil(x as f64) as i32;

i32 Min(i32 a, i32 b) {
    if (a < b) return a;
    return b;
}

i32 Max(i32 a, i32 b) {
    if (a > b) return a;
    return b;
}

// ------------------------------------------------------------------ in a window

// Shows scene in a window titled title, turning its spinning objects, until the window
// is closed. False if no window can be opened (then nothing is shown).
public bool Show(Scene scene, str title) {
    Scene s = scene;
    var w = platform.Window();
    i32 width = 640;
    i32 height = 480;
    if (!w.Open(title, width as u32, height as u32)) return false;
    while (w.IsOpen()) {
        while (true) {
            var e = w.Poll();
            if (e.Is(EventKind.None)) break;
        }
        if (!w.IsOpen()) break;
        gfx.Canvas c = Render(s, w.Width() as i32, w.Height() as i32);
        w.Present(c.Pixels(), w.Width(), w.Height());
        s.Step(1.0 / 30.0);
    }
    return true;
}
