// envor.ecs: spawning and despawning (a reused index gets a new generation, and the old
// handle stays dead), stores as sparse sets (set, replace, remove with the last value
// moved into the gap), and a system running over two stores.
// expect: spawned 3, alive 3
// expect: despawned b: alive false, count 2
// expect: reused index 1 gen 1, old handle alive false
// expect: velocity: a yes, b no, c yes
// expect: after 10 steps: a.x 10, c.x 5
// expect: removed a's velocity: 1 left, c still 0.5
// expect: stale handle: has false
use envor.ecs;
use alloc.text;

struct Position {
    f32 X;
    f32 Y;
}

struct Velocity {
    f32 X;
    f32 Y;
}

str YesNo(bool b) {
    if (b) return "yes";
    return "no";
}

// the system: every entity with both moves by its velocity
void Move(ref ecs.Store<Position> ps, in ecs.Store<Velocity> vs, f32 dt) {
    ecs.Entity[] owners = vs.Entities();
    Velocity[] vels = vs.Values();
    for (usize i = 0; i < owners.Len; i++) {
        usize at = ps.Find(owners[i]);
        if (at >= ps.Len()) continue;
        mut Position[] pos = ps.ValuesMut();
        pos[at].X = pos[at].X + vels[i].X * dt;
        pos[at].Y = pos[at].Y + vels[i].Y * dt;
    }
}

ecs.World w = ecs.World.New();
ecs.Store<Position> ps = ecs.Store<Position>.New();
ecs.Store<Velocity> vs = ecs.Store<Velocity>.New();
ecs.Entity a = w.Spawn();
ecs.Entity b = w.Spawn();
ecs.Entity c = w.Spawn();
write(1, "spawned 3, alive ");
print(text.Uint(w.Count() as u64).AsStr());
ps.Set(a, new Position { X = 0.0, Y = 0.0 });
ps.Set(b, new Position { X = 1.0, Y = 1.0 });
ps.Set(c, new Position { X = 0.0, Y = 2.0 });
vs.Set(a, new Velocity { X = 1.0, Y = 0.0 });
vs.Set(c, new Velocity { X = 0.25, Y = 0.0 });
vs.Set(c, new Velocity { X = 0.5, Y = 0.0 });
w.Despawn(b);
ps.Remove(b);
write(1, "despawned b: alive ");
if (w.IsAlive(b)) write(1, "true");
else write(1, "false");
write(1, ", count ");
print(text.Uint(w.Count() as u64).AsStr());
ecs.Entity d = w.Spawn();
write(1, "reused index ");
write(1, text.Uint(d.IndexOf() as u64).AsStr());
write(1, " gen ");
write(1, text.Uint(d.Generation() as u64).AsStr());
write(1, ", old handle alive ");
if (w.IsAlive(b)) print("true");
else print("false");
write(1, "velocity: a ");
write(1, YesNo(vs.Has(a)));
write(1, ", b ");
write(1, YesNo(vs.Has(b)));
write(1, ", c ");
print(YesNo(vs.Has(c)));
for (i32 k = 0; k < 10; k++) Move(ref ps, vs, 1.0);
write(1, "after 10 steps: a.x ");
write(1, text.FloatShort(ps.Get(a).X as f64).AsStr());
write(1, ", c.x ");
print(text.FloatShort(ps.Get(c).X as f64).AsStr());
vs.Remove(a);
write(1, "removed a's velocity: ");
write(1, text.Uint(vs.Len() as u64).AsStr());
write(1, " left, c still ");
print(text.FloatShort(vs.Get(c).X as f64).AsStr());
ps.Set(d, new Position { X = 9.0, Y = 9.0 });
write(1, "stale handle: has ");
if (ps.Has(b)) print("true");
else print("false");
