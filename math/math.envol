// envor.math: vectors, matrices and quaternions for graphics (M11), in f32. Matrices are
// column-major (m[column * 4 + row]) and act on column vectors (p' = M p), with a
// right-handed world (x right, y up, z toward the viewer) and clip space z in [0, 1].
namespace envor.math;

use core.math as cm;

f32 SqrtF(f32 x) => cm.Sqrt(x as f64) as f32;

public struct Vec2 {
    f32 X;
    f32 Y;

    public static Vec2 Of(f32 x, f32 y) => new Vec2 { X = x, Y = y };
    public Vec2 Add(in this, in Vec2 o) => Vec2.Of(this.X + o.X, this.Y + o.Y);
    public Vec2 Sub(in this, in Vec2 o) => Vec2.Of(this.X - o.X, this.Y - o.Y);
    public Vec2 Mul(in this, f32 s) => Vec2.Of(this.X * s, this.Y * s);
    public f32 Dot(in this, in Vec2 o) => this.X * o.X + this.Y * o.Y;
    public f32 Length(in this) => SqrtF(this.Dot(this));
}

public struct Vec3 {
    f32 X;
    f32 Y;
    f32 Z;

    public static Vec3 Of(f32 x, f32 y, f32 z) => new Vec3 { X = x, Y = y, Z = z };
    public static Vec3 Zero() => Vec3.Of(0.0, 0.0, 0.0);
    public static Vec3 One() => Vec3.Of(1.0, 1.0, 1.0);
    public static Vec3 Up() => Vec3.Of(0.0, 1.0, 0.0);

    public Vec3 Add(in this, in Vec3 o) => Vec3.Of(this.X + o.X, this.Y + o.Y, this.Z + o.Z);
    public Vec3 Sub(in this, in Vec3 o) => Vec3.Of(this.X - o.X, this.Y - o.Y, this.Z - o.Z);
    public Vec3 Mul(in this, f32 s) => Vec3.Of(this.X * s, this.Y * s, this.Z * s);
    // Component by component.
    public Vec3 Scale(in this, in Vec3 o) => Vec3.Of(this.X * o.X, this.Y * o.Y, this.Z * o.Z);
    public Vec3 Neg(in this) => Vec3.Of(-this.X, -this.Y, -this.Z);
    public f32 Dot(in this, in Vec3 o) => this.X * o.X + this.Y * o.Y + this.Z * o.Z;
    public Vec3 Cross(in this, in Vec3 o) => Vec3.Of(this.Y * o.Z - this.Z * o.Y, this.Z * o.X - this.X * o.Z, this.X * o.Y - this.Y * o.X);
    public f32 Length(in this) => SqrtF(this.Dot(this));

    // This vector at length 1; the zero vector stays zero.
    public Vec3 Normalize(in this) {
        f32 l = this.Length();
        if (l == 0.0) return Vec3.Zero();
        return this.Mul(1.0 / l);
    }

    // this + (o - this) * t
    public Vec3 Lerp(in this, in Vec3 o, f32 t) => this.Add(o.Sub(this).Mul(t));

    // The reflection of this (pointing at a surface) about normal n.
    public Vec3 Reflect(in this, in Vec3 n) => this.Sub(n.Mul(2.0 * this.Dot(n)));
}

public struct Vec4 {
    f32 X;
    f32 Y;
    f32 Z;
    f32 W;

    public static Vec4 Of(f32 x, f32 y, f32 z, f32 w) => new Vec4 { X = x, Y = y, Z = z, W = w };
    public static Vec4 Point(in Vec3 p) => Vec4.Of(p.X, p.Y, p.Z, 1.0);
    public Vec3 Xyz(in this) => Vec3.Of(this.X, this.Y, this.Z);
    public f32 Dot(in this, in Vec4 o) => this.X * o.X + this.Y * o.Y + this.Z * o.Z + this.W * o.W;
}

// A rotation: x, y, z the axis times sin(angle/2), w cos(angle/2).
public struct Quat {
    f32 X;
    f32 Y;
    f32 Z;
    f32 W;

    public static Quat Identity() => new Quat { X = 0.0, Y = 0.0, Z = 0.0, W = 1.0 };

    // A rotation by angle radians about axis (any length but zero).
    public static Quat Axis(in Vec3 axis, f32 angle) {
        Vec3 a = axis.Normalize();
        f64 h = angle as f64 * 0.5;
        f32 s = cm.Sin(h) as f32;
        return new Quat { X = a.X * s, Y = a.Y * s, Z = a.Z * s, W = cm.Cos(h) as f32 };
    }

    // this then o: rotating by the result is rotating by o, then by this.
    public Quat Mul(in this, in Quat o) => new Quat {
        X = this.W * o.X + this.X * o.W + this.Y * o.Z - this.Z * o.Y,
        Y = this.W * o.Y - this.X * o.Z + this.Y * o.W + this.Z * o.X,
        Z = this.W * o.Z + this.X * o.Y - this.Y * o.X + this.Z * o.W,
        W = this.W * o.W - this.X * o.X - this.Y * o.Y - this.Z * o.Z,
    };

    public Quat Normalize(in this) {
        f32 l = SqrtF(this.X * this.X + this.Y * this.Y + this.Z * this.Z + this.W * this.W);
        if (l == 0.0) return Quat.Identity();
        f32 k = 1.0 / l;
        return new Quat { X = this.X * k, Y = this.Y * k, Z = this.Z * k, W = this.W * k };
    }

    // v rotated.
    public Vec3 Rotate(in this, in Vec3 v) {
        Vec3 u = Vec3.Of(this.X, this.Y, this.Z);
        Vec3 t = u.Cross(v).Mul(2.0);
        return v.Add(t.Mul(this.W)).Add(u.Cross(t));
    }

    // The rotation between this (at t = 0) and o (at t = 1), along the shorter arc.
    public Quat Slerp(in this, in Quat o0, f32 t) {
        Quat o = new Quat { X = o0.X, Y = o0.Y, Z = o0.Z, W = o0.W };
        f32 d = this.X * o.X + this.Y * o.Y + this.Z * o.Z + this.W * o.W;
        if (d < 0.0) {
            d = -d;
            o = new Quat { X = -o.X, Y = -o.Y, Z = -o.Z, W = -o.W };
        }
        f32 a = 1.0 - t;
        f32 b = t;
        if (d < 0.9995) {
            f64 th = cm.Acos(d as f64);
            f64 s = cm.Sin(th);
            a = (cm.Sin((1.0 - t as f64) * th) / s) as f32;
            b = (cm.Sin(t as f64 * th) / s) as f32;
        }
        Quat r = new Quat { X = this.X * a + o.X * b, Y = this.Y * a + o.Y * b, Z = this.Z * a + o.Z * b, W = this.W * a + o.W * b };
        return r.Normalize();
    }
}

// A 4 x 4 matrix, column-major.
public struct Mat4 {
    f32[16] M;

    public static Mat4 Zero() {
        Mat4 r;
        return r;
    }

    public static Mat4 Identity() {
        Mat4 r;
        r.M[0] = 1.0;
        r.M[5] = 1.0;
        r.M[10] = 1.0;
        r.M[15] = 1.0;
        return r;
    }

    // The element in row r, column c.
    public f32 At(in this, u32 r, u32 c) => this.M[(c * 4 + r) as usize];

    public void Set(ref this, u32 r, u32 c, f32 v) {
        this.M[(c * 4 + r) as usize] = v;
    }

    public static Mat4 Translate(in Vec3 t) {
        Mat4 r = Mat4.Identity();
        r.M[12] = t.X;
        r.M[13] = t.Y;
        r.M[14] = t.Z;
        return r;
    }

    public static Mat4 Scaling(in Vec3 s) {
        Mat4 r = Mat4.Identity();
        r.M[0] = s.X;
        r.M[5] = s.Y;
        r.M[10] = s.Z;
        return r;
    }

    public static Mat4 Rotation(in Quat q) {
        Mat4 r = Mat4.Identity();
        f32 x = q.X;
        f32 y = q.Y;
        f32 z = q.Z;
        f32 w = q.W;
        r.M[0] = 1.0 - 2.0 * (y * y + z * z);
        r.M[1] = 2.0 * (x * y + z * w);
        r.M[2] = 2.0 * (x * z - y * w);
        r.M[4] = 2.0 * (x * y - z * w);
        r.M[5] = 1.0 - 2.0 * (x * x + z * z);
        r.M[6] = 2.0 * (y * z + x * w);
        r.M[8] = 2.0 * (x * z + y * w);
        r.M[9] = 2.0 * (y * z - x * w);
        r.M[10] = 1.0 - 2.0 * (x * x + y * y);
        return r;
    }

    // Translation, rotation and scale, applied scale first.
    public static Mat4 Trs(in Vec3 t, in Quat q, in Vec3 s) => Mat4.Translate(t).Mul(Mat4.Rotation(q)).Mul(Mat4.Scaling(s));

    // A perspective projection: vertical field of view fovY (radians), width/height aspect,
    // near and far planes (positive distances); clip z from 0 at near to 1 at far.
    public static Mat4 Perspective(f32 fovY, f32 aspect, f32 near, f32 far) {
        f32 f = (1.0 / cm.Tan(fovY as f64 * 0.5)) as f32;
        Mat4 r = Mat4.Zero();
        r.M[0] = f / aspect;
        r.M[5] = f;
        r.M[10] = far / (near - far);
        r.M[11] = -1.0;
        r.M[14] = near * far / (near - far);
        return r;
    }

    // The view from eye looking at target, with up roughly up.
    public static Mat4 LookAt(in Vec3 eye, in Vec3 target, in Vec3 up) {
        Vec3 f = target.Sub(eye).Normalize();
        Vec3 s = f.Cross(up).Normalize();
        Vec3 u = s.Cross(f);
        Mat4 r = Mat4.Identity();
        r.M[0] = s.X;
        r.M[4] = s.Y;
        r.M[8] = s.Z;
        r.M[1] = u.X;
        r.M[5] = u.Y;
        r.M[9] = u.Z;
        r.M[2] = -f.X;
        r.M[6] = -f.Y;
        r.M[10] = -f.Z;
        r.M[12] = -s.Dot(eye);
        r.M[13] = -u.Dot(eye);
        r.M[14] = f.Dot(eye);
        return r;
    }

    // this × o: applying the result is applying o, then this.
    public Mat4 Mul(in this, in Mat4 o) {
        Mat4 r;
        for (u32 c = 0; c < 4; c++) {
            for (u32 row = 0; row < 4; row++) {
                f32 s = 0.0;
                for (u32 k = 0; k < 4; k++) s += this.M[(k * 4 + row) as usize] * o.M[(c * 4 + k) as usize];
                r.M[(c * 4 + row) as usize] = s;
            }
        }
        return r;
    }

    public Vec4 MulVec4(in this, in Vec4 v) {
        f32[4] x;
        x[0] = v.X;
        x[1] = v.Y;
        x[2] = v.Z;
        x[3] = v.W;
        f32[4] r;
        for (u32 row = 0; row < 4; row++) {
            f32 s = 0.0;
            for (u32 k = 0; k < 4; k++) s += this.M[(k * 4 + row) as usize] * x[k as usize];
            r[row as usize] = s;
        }
        return Vec4.Of(r[0], r[1], r[2], r[3]);
    }

    // A point (w = 1), divided by w.
    public Vec3 TransformPoint(in this, in Vec3 p) {
        Vec4 r = this.MulVec4(Vec4.Point(p));
        if (r.W == 0.0 || r.W == 1.0) return r.Xyz();
        return r.Xyz().Mul(1.0 / r.W);
    }

    // A direction (w = 0): no translation.
    public Vec3 TransformDir(in this, in Vec3 d) => this.MulVec4(Vec4.Of(d.X, d.Y, d.Z, 0.0)).Xyz();

    public Mat4 Transpose(in this) {
        Mat4 r;
        for (u32 c = 0; c < 4; c++) {
            for (u32 row = 0; row < 4; row++) r.M[(row * 4 + c) as usize] = this.M[(c * 4 + row) as usize];
        }
        return r;
    }

    // The inverse (Gauss-Jordan with partial pivoting); the identity if this is singular.
    public Mat4 Inverse(in this) {
        f64[32] a;
        for (u32 row = 0; row < 4; row++) {
            for (u32 c = 0; c < 4; c++) {
                a[(row * 8 + c) as usize] = this.M[(c * 4 + row) as usize] as f64;
                a[(row * 8 + 4 + c) as usize] = 0.0;
            }
            a[(row * 8 + 4 + row) as usize] = 1.0;
        }
        for (u32 col = 0; col < 4; col++) {
            u32 pivot = col;
            for (u32 row = col + 1; row < 4; row++) {
                if (cm.FAbs(a[(row * 8 + col) as usize]) > cm.FAbs(a[(pivot * 8 + col) as usize])) pivot = row;
            }
            if (cm.FAbs(a[(pivot * 8 + col) as usize]) < 1e-30) return Mat4.Identity();
            if (pivot != col) {
                for (u32 k = 0; k < 8; k++) {
                    f64 t = a[(col * 8 + k) as usize];
                    a[(col * 8 + k) as usize] = a[(pivot * 8 + k) as usize];
                    a[(pivot * 8 + k) as usize] = t;
                }
            }
            f64 inv = 1.0 / a[(col * 8 + col) as usize];
            for (u32 k = 0; k < 8; k++) a[(col * 8 + k) as usize] = a[(col * 8 + k) as usize] * inv;
            for (u32 row = 0; row < 4; row++) {
                if (row == col) continue;
                f64 fct = a[(row * 8 + col) as usize];
                if (fct == 0.0) continue;
                for (u32 k = 0; k < 8; k++) a[(row * 8 + k) as usize] = a[(row * 8 + k) as usize] - fct * a[(col * 8 + k) as usize];
            }
        }
        Mat4 r;
        for (u32 row = 0; row < 4; row++) {
            for (u32 c = 0; c < 4; c++) r.M[(c * 4 + row) as usize] = a[(row * 8 + 4 + c) as usize] as f32;
        }
        return r;
    }
}

// degrees to radians
public f32 Radians(f32 degrees) => degrees * 0.017453292519943295;
