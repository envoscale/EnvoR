// envor.theme: the Envor design language's tokens as typed values (docs/lumen/README.md).
// tokens.envon is the source; Light and Dark here are the same values, and the tests check
// that they agree. A theme is a Theme value: change any field to restyle a program.
namespace envor.theme;

use envo.eon;
use alloc.text;

// The color roles, as 0xRRGGBB.
public struct Colors {
    u32 Background;
    u32 Surface;
    u32 SurfaceRaised;
    u32 SurfacePressed;
    u32 Text;
    u32 TextSecondary;
    u32 Separator;
    u32 ControlEdge;
    u32 Accent;
    u32 AccentHover;
    u32 OnAccent;
    u32 Danger;
    u32 Success;
    u32 Warning;
}

// A type style: size and line height in pixels.
public struct TypeStyle {
    u32 Size;
    u32 Line;
}

public struct Theme {
    bool IsDark;
    Colors C;
    TypeStyle Caption;
    TypeStyle Body;
    TypeStyle Headline;
    TypeStyle Title;
    TypeStyle LargeTitle;
    u32 Xs;
    u32 S;
    u32 M;
    u32 L;
    u32 Xl;
    u32 Xxl;
    u32 RadiusSmall;
    u32 RadiusMedium;
    u32 RadiusLarge;
    u32 ControlHeight;
    u32 FocusRing;
    u32 MotionFast;
    u32 MotionNormal;

    // Every value, one per line: what the tests compare.
    public string Describe(in this) {
        string s = string.New();
        if (this.IsDark) s.Append("dark\n");
        else s.Append("light\n");
        Hex(ref s, "background", this.C.Background);
        Hex(ref s, "surface", this.C.Surface);
        Hex(ref s, "surfaceRaised", this.C.SurfaceRaised);
        Hex(ref s, "surfacePressed", this.C.SurfacePressed);
        Hex(ref s, "text", this.C.Text);
        Hex(ref s, "textSecondary", this.C.TextSecondary);
        Hex(ref s, "separator", this.C.Separator);
        Hex(ref s, "controlEdge", this.C.ControlEdge);
        Hex(ref s, "accent", this.C.Accent);
        Hex(ref s, "accentHover", this.C.AccentHover);
        Hex(ref s, "onAccent", this.C.OnAccent);
        Hex(ref s, "danger", this.C.Danger);
        Hex(ref s, "success", this.C.Success);
        Hex(ref s, "warning", this.C.Warning);
        Pair(ref s, "caption", this.Caption);
        Pair(ref s, "body", this.Body);
        Pair(ref s, "headline", this.Headline);
        Pair(ref s, "title", this.Title);
        Pair(ref s, "largeTitle", this.LargeTitle);
        Num(ref s, "xs", this.Xs);
        Num(ref s, "s", this.S);
        Num(ref s, "m", this.M);
        Num(ref s, "l", this.L);
        Num(ref s, "xl", this.Xl);
        Num(ref s, "xxl", this.Xxl);
        Num(ref s, "small", this.RadiusSmall);
        Num(ref s, "medium", this.RadiusMedium);
        Num(ref s, "large", this.RadiusLarge);
        Num(ref s, "height", this.ControlHeight);
        Num(ref s, "focusRing", this.FocusRing);
        Num(ref s, "fast", this.MotionFast);
        Num(ref s, "normal", this.MotionNormal);
        return s;
    }
}

void Hex(ref string s, str name, u32 c) {
    s.Append(name);
    s.Append(" #");
    s.Append(text.Hex(c as u64, 6).AsStr());
    s.AppendByte(10);
}

void Pair(ref string s, str name, in TypeStyle t) {
    s.Append(name);
    s.AppendByte(' ');
    s.Append(text.Uint(t.Size as u64).AsStr());
    s.AppendByte('/');
    s.Append(text.Uint(t.Line as u64).AsStr());
    s.AppendByte(10);
}

void Num(ref string s, str name, u32 v) {
    s.Append(name);
    s.AppendByte(' ');
    s.Append(text.Uint(v as u64).AsStr());
    s.AppendByte(10);
}

Theme Shared(bool dark, Colors c) => new Theme {
    IsDark = dark, C = c,
    Caption = new TypeStyle { Size = 12, Line = 16 },
    Body = new TypeStyle { Size = 15, Line = 20 },
    Headline = new TypeStyle { Size = 17, Line = 24 },
    Title = new TypeStyle { Size = 22, Line = 28 },
    LargeTitle = new TypeStyle { Size = 28, Line = 36 },
    Xs = 4, S = 8, M = 12, L = 16, Xl = 24, Xxl = 32,
    RadiusSmall = 6, RadiusMedium = 10, RadiusLarge = 14,
    ControlHeight = 32, FocusRing = 2,
    MotionFast = 120, MotionNormal = 200,
};

// Envor's light scheme.
public Theme Light() => Shared(false, new Colors {
    Background = 0xf5f5f7, Surface = 0xffffff, SurfaceRaised = 0xffffff, SurfacePressed = 0xe8e8ed,
    Text = 0x1d1d1f, TextSecondary = 0x68686c, Separator = 0xc7c7cc, ControlEdge = 0x85858a,
    Accent = 0x0a64d4, AccentHover = 0x0858bd, OnAccent = 0xffffff,
    Danger = 0xd30015, Success = 0x1f7835, Warning = 0xab4d00,
});

// Envor's dark scheme.
public Theme Dark() => Shared(true, new Colors {
    Background = 0x000000, Surface = 0x1c1c1e, SurfaceRaised = 0x2c2c2e, SurfacePressed = 0x3a3a3c,
    Text = 0xf5f5f7, TextSecondary = 0xa3a3a8, Separator = 0x48484a, ControlEdge = 0x8e8e93,
    Accent = 0x60a6ff, AccentHover = 0x6eafff, OnAccent = 0x000000,
    Danger = 0xff7b74, Success = 0x30d158, Warning = 0xffb340,
});

// A theme from tokens written in EON (tokens.envon's shape), for scheme "light" or "dark".
// A value the tokens leave out keeps Envor's.
public Result<Theme, string> FromTokens(str src, str scheme) {
    Result<eon.Value, eon.ParseError> r = eon.Parse(src);
    if (r.IsErr()) return Err(r.UnwrapErr().Describe());
    eon.Value doc = r.Unwrap();
    bool dark = Same(scheme, "dark");
    Theme t = Light();
    if (dark) t = Dark();
    eon.Value[] colors = doc.Field(scheme);
    if (colors.Len == 1) {
        var c = colors[0];
        t.C.Background = Color(c, "background", t.C.Background);
        t.C.Surface = Color(c, "surface", t.C.Surface);
        t.C.SurfaceRaised = Color(c, "surfaceRaised", t.C.SurfaceRaised);
        t.C.SurfacePressed = Color(c, "surfacePressed", t.C.SurfacePressed);
        t.C.Text = Color(c, "text", t.C.Text);
        t.C.TextSecondary = Color(c, "textSecondary", t.C.TextSecondary);
        t.C.Separator = Color(c, "separator", t.C.Separator);
        t.C.ControlEdge = Color(c, "controlEdge", t.C.ControlEdge);
        t.C.Accent = Color(c, "accent", t.C.Accent);
        t.C.AccentHover = Color(c, "accentHover", t.C.AccentHover);
        t.C.OnAccent = Color(c, "onAccent", t.C.OnAccent);
        t.C.Danger = Color(c, "danger", t.C.Danger);
        t.C.Success = Color(c, "success", t.C.Success);
        t.C.Warning = Color(c, "warning", t.C.Warning);
    }
    eon.Value[] ty = doc.Field("type");
    if (ty.Len == 1) {
        t.Caption = Style(ty[0], "caption", t.Caption);
        t.Body = Style(ty[0], "body", t.Body);
        t.Headline = Style(ty[0], "headline", t.Headline);
        t.Title = Style(ty[0], "title", t.Title);
        t.LargeTitle = Style(ty[0], "largeTitle", t.LargeTitle);
    }
    eon.Value[] sp = doc.Field("space");
    if (sp.Len == 1) {
        t.Xs = Int(sp[0], "xs", t.Xs);
        t.S = Int(sp[0], "s", t.S);
        t.M = Int(sp[0], "m", t.M);
        t.L = Int(sp[0], "l", t.L);
        t.Xl = Int(sp[0], "xl", t.Xl);
        t.Xxl = Int(sp[0], "xxl", t.Xxl);
    }
    eon.Value[] ra = doc.Field("radius");
    if (ra.Len == 1) {
        t.RadiusSmall = Int(ra[0], "small", t.RadiusSmall);
        t.RadiusMedium = Int(ra[0], "medium", t.RadiusMedium);
        t.RadiusLarge = Int(ra[0], "large", t.RadiusLarge);
    }
    eon.Value[] co = doc.Field("control");
    if (co.Len == 1) {
        t.ControlHeight = Int(co[0], "height", t.ControlHeight);
        t.FocusRing = Int(co[0], "focusRing", t.FocusRing);
    }
    eon.Value[] mo = doc.Field("motion");
    if (mo.Len == 1) {
        t.MotionFast = Int(mo[0], "fast", t.MotionFast);
        t.MotionNormal = Int(mo[0], "normal", t.MotionNormal);
    }
    return Ok(t);
}

u32 Color(in eon.Value block, str key, u32 otherwise) {
    str? v = block.GetStr(key);
    if (v.IsNone()) return otherwise;
    str h = v.Unwrap();
    if (h.Len != 7 || h[0] != '#') return otherwise;
    u32 c = 0;
    for (usize i = 1; i < 7; i++) {
        u8 d = h[i];
        u32 n = 0;
        if (d >= '0' && d <= '9') n = (d - '0') as u32;
        else if (d >= 'a' && d <= 'f') n = (d - 'a') as u32 + 10;
        else if (d >= 'A' && d <= 'F') n = (d - 'A') as u32 + 10;
        else return otherwise;
        c = c * 16 + n;
    }
    return c;
}

u32 Int(in eon.Value block, str key, u32 otherwise) {
    i64? v = block.GetInt(key);
    if (v.IsNone()) return otherwise;
    i64 n = v.Unwrap();
    if (n < 0 || n > 100000) return otherwise;
    return n as u32;
}

TypeStyle Style(in eon.Value block, str key, in TypeStyle otherwise) {
    eon.Value[] f = block.Field(key);
    if (f.Len != 1 || !f[0].IsArray() || f[0].Len() != 2) return new TypeStyle { Size = otherwise.Size, Line = otherwise.Line };
    eon.Value[] e = f[0].Elements();
    return new TypeStyle { Size = e[0].AsInt() as u32, Line = e[1].AsInt() as u32 };
}

bool Same(str a, str b) {
    if (a.Len != b.Len) return false;
    for (usize i = 0; i < a.Len; i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}
