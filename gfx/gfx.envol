// envor.gfx: 2D drawing on an RGBA canvas in software (PLAN D44). Integer and fixed-point
// arithmetic only (Envo-S1 has no floats): coordinates are whole pixels, and edges are
// anti-aliased by measuring coverage on a 4 x 4 grid inside each edge pixel. Colors blend
// source-over with straight (not premultiplied) alpha. The GPU adapters (envo.gpu) draw
// the same things faster.
namespace envor.gfx;

use envo.crypto.sha2;
use alloc.text;

// A color: red, green, blue and alpha, 0 to 255.
public struct Color {
    u8 R;
    u8 G;
    u8 B;
    u8 A;

    public static Color Rgb(u8 r, u8 g, u8 b) => new Color { R = r, G = g, B = b, A = 255 };
    public static Color Rgba(u8 r, u8 g, u8 b, u8 a) => new Color { R = r, G = g, B = b, A = a };

    // "#rrggbb" or "#rrggbbaa"; black for anything else.
    public static Color Hex(str h) {
        if (h.Len != 7 && h.Len != 9 || h[0] != '#') return Color.Rgb(0, 0, 0);
        u8 a = 255;
        if (h.Len == 9) a = Byte(h, 7);
        return Color.Rgba(Byte(h, 1), Byte(h, 3), Byte(h, 5), a);
    }

    // The same color with its alpha scaled by coverage (0 to 16).
    public Color Covered(in this, u32 coverage) => Color.Rgba(this.R, this.G, this.B, ((this.A as u32 * coverage + 8) / 16) as u8);

    public u8 Red(in this) => this.R;
    public u8 Green(in this) => this.G;
    public u8 Blue(in this) => this.B;
    public u8 Alpha(in this) => this.A;
}

u8 HexDigit(u8 c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return 0;
}

u8 Byte(str h, usize at) => HexDigit(h[at]) * 16 + HexDigit(h[at + 1]);

// x * y / 255, rounded.
u32 Mul255(u32 x, u32 y) {
    u32 t = x * y + 128;
    return (t + (t >> 8)) >> 8;
}

// An image: width x height pixels, RGBA, rows from the top.
public struct Canvas {
    i32 W;
    i32 H;
    List<u8> Px;
    i32 CX0;                // the clip: drawing lands only in [CX0, CX1) x [CY0, CY1)
    i32 CY0;
    i32 CX1;
    i32 CY1;

    public static Canvas New(i32 width, i32 height) {
        Canvas c = new Canvas { W = width, H = height, Px = List<u8>.New(), CX0 = 0, CY0 = 0, CX1 = width, CY1 = height };
        usize n = (width * height * 4) as usize;
        for (usize i = 0; i < n; i++) c.Px.Push(0);
        return c;
    }

    // A canvas holding width x height RGBA pixels (a GPU frame, a decoded image); missing
    // pixels are transparent.
    public static Canvas FromRgba(i32 width, i32 height, u8[] rgba) {
        Canvas c = Canvas.New(width, height);
        mut u8[] p = c.Px.AsMutSlice();
        for (usize i = 0; i < p.Len && i < rgba.Len; i++) p[i] = rgba[i];
        return c;
    }

    public i32 Width(in this) => this.W;
    public i32 Height(in this) => this.H;
    // The pixels, RGBA, rows from the top.
    public u8[] Pixels(in this) => this.Px.AsSlice();

    public Color Get(in this, i32 x, i32 y) {
        if (x < 0 || y < 0 || x >= this.W || y >= this.H) return Color.Rgba(0, 0, 0, 0);
        usize at = ((y * this.W + x) * 4) as usize;
        u8[] p = this.Px.AsSlice();
        return Color.Rgba(p[at], p[at + 1], p[at + 2], p[at + 3]);
    }

    // Drawing lands only inside the w x h rectangle at (x, y) (and the canvas) until
    // the next SetClip or ResetClip. Clear ignores the clip.
    public void SetClip(ref this, i32 x, i32 y, i32 w, i32 h) {
        this.CX0 = Max(x, 0);
        this.CY0 = Max(y, 0);
        this.CX1 = Min(x + w, this.W);
        this.CY1 = Min(y + h, this.H);
    }

    // Drawing lands anywhere on the canvas again.
    public void ResetClip(ref this) => this.SetClip(0, 0, this.W, this.H);

    // Draws c over pixel (x, y): source-over blending; outside the canvas or the clip,
    // nothing.
    public void Blend(ref this, i32 x, i32 y, Color c) {
        if (x < this.CX0 || y < this.CY0 || x >= this.CX1 || y >= this.CY1 || c.A == 0) return;
        usize at = ((y * this.W + x) * 4) as usize;
        unsafe {
            *u8 p = &this.Px.Data[at];
            if (c.A == 255) {
                p[0] = c.R;
                p[1] = c.G;
                p[2] = c.B;
                p[3] = 255;
                return;
            }
            u32 sa = c.A as u32;
            u32 da = p[3] as u32;
            // out alpha = sa + da (1 - sa)
            u32 oa = sa + Mul255(da, 255 - sa);
            if (oa == 0) return;
            u32 dw = Mul255(da, 255 - sa);
            p[0] = ((c.R as u32 * sa + p[0] as u32 * dw + oa / 2) / oa) as u8;
            p[1] = ((c.G as u32 * sa + p[1] as u32 * dw + oa / 2) / oa) as u8;
            p[2] = ((c.B as u32 * sa + p[2] as u32 * dw + oa / 2) / oa) as u8;
            p[3] = oa as u8;
        }
    }

    // Every pixel set to c (no blending).
    public void Clear(ref this, Color c) {
        unsafe {
            *u8 p = this.Px.Data;
            usize n = (this.W * this.H) as usize;
            for (usize i = 0; i < n; i++) {
                p[4 * i] = c.R;
                p[4 * i + 1] = c.G;
                p[4 * i + 2] = c.B;
                p[4 * i + 3] = c.A;
            }
        }
    }

    public void FillRect(ref this, i32 x, i32 y, i32 w, i32 h, Color c) {
        i32 x0 = Max(x, this.CX0);
        i32 y0 = Max(y, this.CY0);
        i32 x1 = Min(x + w, this.CX1);
        i32 y1 = Min(y + h, this.CY1);
        for (i32 py = y0; py < y1; py++) {
            for (i32 px = x0; px < x1; px++) this.Blend(px, py, c);
        }
    }

    // A rectangle's outline, thickness pixels wide, inside the rectangle.
    public void StrokeRect(ref this, i32 x, i32 y, i32 w, i32 h, i32 thickness, Color c) {
        this.FillRect(x, y, w, thickness, c);
        this.FillRect(x, y + h - thickness, w, thickness, c);
        this.FillRect(x, y + thickness, thickness, h - 2 * thickness, c);
        this.FillRect(x + w - thickness, y + thickness, thickness, h - 2 * thickness, c);
    }

    // A one-pixel line from (x0, y0) to (x1, y1), both ends included (Bresenham).
    public void Line(ref this, i32 x0, i32 y0, i32 x1, i32 y1, Color c) {
        i32 dx = Abs(x1 - x0);
        i32 dy = 0 - Abs(y1 - y0);
        i32 sx = 1;
        if (x0 > x1) sx = -1;
        i32 sy = 1;
        if (y0 > y1) sy = -1;
        i32 err = dx + dy;
        i32 x = x0;
        i32 y = y0;
        while (true) {
            this.Blend(x, y, c);
            if (x == x1 && y == y1) break;
            i32 e2 = 2 * err;
            if (e2 >= dy) {
                err += dy;
                x += sx;
            }
            if (e2 <= dx) {
                err += dx;
                y += sy;
            }
        }
    }

    // A filled circle centred at (cx, cy), with anti-aliased edges.
    public void FillCircle(ref this, i32 cx, i32 cy, i32 r, Color c) {
        this.FillRoundedRect(cx - r, cy - r, 2 * r, 2 * r, r, c);
    }

    // A filled rectangle with corners of the given radius, anti-aliased.
    public void FillRoundedRect(ref this, i32 x, i32 y, i32 w, i32 h, i32 radius, Color c) {
        i32 r = Min(radius, Min(w, h) / 2);
        if (r <= 0) {
            this.FillRect(x, y, w, h, c);
            return;
        }
        for (i32 py = Max(y, 0); py < Min(y + h, this.H); py++) {
            for (i32 px = Max(x, 0); px < Min(x + w, this.W); px++) {
                // the corner's centre this pixel is nearest, if it is in a corner
                i32 ccx = 0;
                i32 ccy = 0;
                bool corner = false;
                if (px < x + r && py < y + r) { ccx = x + r; ccy = y + r; corner = true; }
                if (px >= x + w - r && py < y + r) { ccx = x + w - r; ccy = y + r; corner = true; }
                if (px < x + r && py >= y + h - r) { ccx = x + r; ccy = y + h - r; corner = true; }
                if (px >= x + w - r && py >= y + h - r) { ccx = x + w - r; ccy = y + h - r; corner = true; }
                if (!corner) {
                    this.Blend(px, py, c);
                    continue;
                }
                // coverage: of the 16 sub-points, how many lie in the circle (radius r,
                // in eighths of a pixel)
                u32 coverage = 0;
                for (i32 sy = 0; sy < 4; sy++) {
                    for (i32 sx = 0; sx < 4; sx++) {
                        i32 dx = (px * 8 + 1 + 2 * sx) - ccx * 8;
                        i32 dy = (py * 8 + 1 + 2 * sy) - ccy * 8;
                        if (dx * dx + dy * dy <= r * r * 64) coverage++;
                    }
                }
                if (coverage > 0) this.Blend(px, py, c.Covered(coverage));
            }
        }
    }

    // A filled triangle (any winding), with anti-aliased edges.
    public void FillTriangle(ref this, i32 ax, i32 ay, i32 bx, i32 by, i32 qx, i32 qy, Color c) {
        i32 minX = Max(Min(ax, Min(bx, qx)), 0);
        i32 maxX = Min(Max(ax, Max(bx, qx)), this.W - 1);
        i32 minY = Max(Min(ay, Min(by, qy)), 0);
        i32 maxY = Min(Max(ay, Max(by, qy)), this.H - 1);
        i64 area = Edge(ax, ay, bx, by, qx, qy);
        if (area == 0) return;
        for (i32 py = minY; py <= maxY; py++) {
            for (i32 px = minX; px <= maxX; px++) {
                u32 coverage = 0;
                for (i32 sy = 0; sy < 4; sy++) {
                    for (i32 sx = 0; sx < 4; sx++) {
                        // sample points at eighths of a pixel, vertices at pixel corners
                        i32 sxp = px * 8 + 1 + 2 * sx;
                        i32 syp = py * 8 + 1 + 2 * sy;
                        i64 w0 = Edge(bx * 8, by * 8, qx * 8, qy * 8, sxp, syp);
                        i64 w1 = Edge(qx * 8, qy * 8, ax * 8, ay * 8, sxp, syp);
                        i64 w2 = Edge(ax * 8, ay * 8, bx * 8, by * 8, sxp, syp);
                        bool inside = (w0 >= 0 && w1 >= 0 && w2 >= 0) || (w0 <= 0 && w1 <= 0 && w2 <= 0);
                        if (inside) coverage++;
                    }
                }
                if (coverage > 0) this.Blend(px, py, c.Covered(coverage));
            }
        }
    }

    // Draws src over this canvas with its top-left corner at (x, y).
    public void Blit(ref this, in Canvas src, i32 x, i32 y) {
        for (i32 py = 0; py < src.H; py++) {
            for (i32 px = 0; px < src.W; px++) this.Blend(x + px, y + py, src.Get(px, py));
        }
    }

    // The SHA-256 of the pixels as hex: golden tests compare it.
    public string Hash(in this) {
        sha2.Sha256 h = sha2.Sha256.New();
        h.Update(this.Px.AsSlice());
        u8[32] d;
        h.Finish(d[0..32]);
        string s = string.New();
        for (usize i = 0; i < 32; i++) s.Append(text.Hex(d[i] as u64, 2).AsStr());
        return s;
    }

    // The image as a binary PPM (P6): RGB, alpha dropped. For looking at a test's output.
    public string Ppm(in this) {
        string s = string.From("P6\n");
        s.Append(text.Int(this.W as i64).AsStr());
        s.AppendByte(' ');
        s.Append(text.Int(this.H as i64).AsStr());
        s.Append("\n255\n");
        u8[] p = this.Px.AsSlice();
        for (usize i = 0; i < (this.W * this.H) as usize; i++) {
            s.AppendByte(p[4 * i]);
            s.AppendByte(p[4 * i + 1]);
            s.AppendByte(p[4 * i + 2]);
        }
        return s;
    }
}

// Twice the signed area of (a, b, p): which side of the line a-b the point p is on.
i64 Edge(i32 ax, i32 ay, i32 bx, i32 by, i32 px, i32 py) => (bx - ax) as i64 * (py - ay) as i64 - (by - ay) as i64 * (px - ax) as i64;

i32 Min(i32 a, i32 b) {
    if (a < b) return a;
    return b;
}

i32 Max(i32 a, i32 b) {
    if (a > b) return a;
    return b;
}

i32 Abs(i32 a) {
    if (a < 0) return 0 - a;
    return a;
}
